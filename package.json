{
  "name": "visualtex",
  "private": true,
  "version": "1.0.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "npm run build",
    "preview": "vite preview",
    "deploy:web": "npx wrangler deploy",
    "test:landing": "node scripts/landing_page_smoke.mjs",
    "build:landing-art": "node scripts/landing/build_landing_art.mjs",
    "test:web-ocr": "node scripts/web_ocr_worker_smoke.mjs",
    "test:ideographic-comma": "npm run build:test && node scripts/ideographic_comma_regression.mjs",
    "build:test": "VITE_VISUALTEX_EDITOR_AT_ROOT=1 tsc --noEmit && VITE_VISUALTEX_EDITOR_AT_ROOT=1 vite build",
    "sync:mac-editor": "node scripts/sync-mac-editor.mjs",
    "check:mac-editor": "node scripts/sync-mac-editor.mjs --check",
    "test:input-behavior": "npm run build:test && node scripts/input_behavior_regression.mjs",
    "test:radical-render": "npm run build:test && node scripts/radical_render_regression.mjs",
    "test:formula-hotkeys": "npm run build:test && node scripts/formula_hotkey_regression.mjs",
    "test:custom-symbols": "npm run build:test && tsx scripts/custom_symbol_registry_regression.mts && node scripts/custom_symbol_noninterference_regression.mjs && node scripts/custom_symbol_glyph_compiler_regression.mjs && node scripts/custom_symbol_designer_ui_regression.mjs && node scripts/custom_symbol_runtime_sync_regression.mjs",
    "test:align-cases": "npm run build:test && node scripts/align_cases_regression.mjs",
    "test:core-latex-compatibility": "tsx scripts/core_latex_command_compatibility_regression.mts",
    "test:history": "node scripts/history_manager_smoke.mjs",
    "test:toolbar-completion": "npm run build:test && tsx scripts/toolbar_template_completion_regression.mts && node scripts/targeted_editor_regression.mjs toolbar-template-completion",
    "test:latex-format": "node --experimental-strip-types scripts/latex_format_smoke.mjs",
    "test:source-structural": "npm run build:test && tsx scripts/source_structural_draft_regression.mts && node scripts/targeted_editor_regression.mjs source-auto-close-completion && node scripts/targeted_editor_regression.mjs source-preview-only",
    "test:source-editor-ux": "npm run build:test && tsx scripts/source_editor_ux_regression.mts && node scripts/targeted_editor_regression.mjs source-editor-ux",
    "test:inline-text-latex-format": "tsx scripts/inline_text_latex_format_regression.mts",
    "test:markdown-export": "node --experimental-strip-types scripts/markdown_export_smoke.mjs",
    "test:svg-export": "tsx scripts/svg_export_smoke.mjs",
    "test:rare-integral-glyphs": "node --experimental-strip-types scripts/rare_integral_glyph_registry_regression.mjs",
    "test:mathlive-integrals": "npm run build:test && node scripts/mathlive_integral_regression.mjs",
    "test:mathlive-runtime-safety:run": "tsx scripts/mathlive_source_safety_regression.mts && tsx scripts/editor_crash_recovery_regression.mts && node scripts/mathlive_runtime_safety_browser_regression.mjs",
    "test:mathlive-runtime-safety": "npm run build:test && npm run test:mathlive-runtime-safety:run",
    "test:native-suggestion-previews": "npm run build:test && node scripts/native_suggestion_preview_regression.mjs --audit",
    "test:ime-enter": "tsx scripts/ime_enter_regression.mjs",
    "test:selection": "node scripts/selection_regression.mjs",
    "test:editor-lifecycle": "node scripts/editor_lifecycle_regression.mjs",
    "test:editor-cleanup": "tsx scripts/command_registry_contract_regression.mts && node scripts/editor_cleanup_regression.mjs",
    "test:startup-compatibility": "tsx scripts/startup_compatibility_smoke.mjs",
    "test:startup-browser": "node scripts/startup_browser_regression.mjs",
    "test:editor-refactor": "node scripts/history_manager_smoke.mjs && tsx scripts/editor_persistence_isolation_regression.mjs && node scripts/editor_session_regression.mjs && node scripts/editor_lifecycle_regression.mjs && node scripts/editor_cleanup_regression.mjs",
    "test:web-editor": "npm run build:test && node scripts/web_editor_migration_smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.2",
    "mathlive": "^0.109.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "opentype.js": "^2.0.0",
    "tsx": "4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
