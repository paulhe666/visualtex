{
  "name": "visualtex",
  "private": true,
  "version": "1.0.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:web": "npm run build",
    "preview": "vite preview",
    "deploy:web": "npx wrangler deploy",
    "test:landing": "node scripts/landing_page_smoke.mjs",
    "build:landing-art": "node scripts/landing/build_landing_art.mjs",
    "test:web-editor:run": "node scripts/web_editor_migration_smoke.mjs",
    "test:web-ocr": "node scripts/web_ocr_worker_smoke.mjs",
    "test:web-editor": "npm run build && npm run test:web-ocr && npm run test:web-editor:run",
    "test:editor:run": "node scripts/editor_regression_smoke.mjs",
    "test:editor": "npm run build && npm run test:editor:run",
    "test:editor-history:run": "node scripts/editor_history_regression.mjs",
    "test:editor-history": "npm run build && npm run test:editor-history:run",
    "test:input-behavior": "npm run build && node scripts/input_behavior_regression.mjs",
    "test:auto-escape": "npm run build && node scripts/auto_escape_regression.mjs",
    "test:radical-render": "npm run build && node scripts/radical_render_regression.mjs",
    "test:formula-hotkeys": "npm run build && node scripts/formula_hotkey_regression.mjs",
    "test:editor-layout": "npm run build && node scripts/editor_layout_switch_regression.mjs",
    "test:enter-transition": "npm run build && node scripts/enter_transition_regression.mjs",
    "test:ideographic-comma": "npm run build && node scripts/ideographic_comma_regression.mjs",
    "test:history": "node scripts/history_manager_smoke.mjs",
    "test:latex-format": "node --experimental-strip-types scripts/latex_format_smoke.mjs",
    "test:markdown-export": "node --experimental-strip-types scripts/markdown_export_smoke.mjs",
    "test:svg-export": "node --experimental-strip-types scripts/svg_export_smoke.mjs",
    "test:suggestion-settings": "node --experimental-strip-types scripts/suggestion_settings_smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.1",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.2",
    "mathlive": "^0.109.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "opentype.js": "^2.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
