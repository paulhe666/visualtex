{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "visualtexweb",
  "compatibility_date": "2026-07-11",
  "main": "./worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  }
}
