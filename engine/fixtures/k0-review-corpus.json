{
  "schema": "visualtex-k0-review-v1",
  "scope": "Independent P03/P04 corpus; passing lossless preservation does not assert edit/layout/Office support.",
  "cases": [
    {"id":"empty", "source":"", "expect":"supported", "canonical":"", "fractions":0, "scripts":0},
    {"id":"ordinary", "source":"x+12=y", "expect":"supported", "canonical":"x+12=y", "fractions":0, "scripts":0},
    {"id":"fraction", "source":"\\frac{a}{b}", "expect":"supported", "canonical":"\\frac{a}{b}", "fractions":1, "scripts":0},
    {"id":"bare-fraction-arguments", "source":"\\frac12", "expect":"supported", "canonical":"\\frac{1}{2}", "fractions":1, "scripts":0},
    {"id":"spaced-bare-arguments", "source":"\\frac x y", "expect":"supported", "canonical":"\\frac{x}{y}", "fractions":1, "scripts":0},
    {"id":"nested-fraction", "source":"\\frac{a+\\frac{b}{c}}{d}", "expect":"supported", "canonical":"\\frac{a+\\frac{b}{c}}{d}", "fractions":2, "scripts":0},
    {"id":"display-fraction-spelling", "source":"\\dfrac {x}{y}", "expect":"supported", "canonical":"\\dfrac{x}{y}", "fractions":1, "scripts":0},
    {"id":"text-fraction-spelling", "source":"\\tfrac{x}{y}", "expect":"supported", "canonical":"\\tfrac{x}{y}", "fractions":1, "scripts":0},
    {"id":"fraction-comments", "source":"  \\frac % numerator\r\n {a} % denominator\n {b}  ", "expect":"supported", "canonical":"\\frac{a}{b}", "fractions":1, "scripts":0},
    {"id":"superscript-one-token", "source":"x^23", "expect":"supported", "canonical":"x^{2}3", "fractions":0, "scripts":1},
    {"id":"superscript-group", "source":"x^{23}", "expect":"supported", "canonical":"x^{23}", "fractions":0, "scripts":1},
    {"id":"both-scripts", "source":"x_1^2", "expect":"supported", "canonical":"x_{1}^{2}", "fractions":0, "scripts":1},
    {"id":"script-order-preserved", "source":"x^2_1", "expect":"supported", "canonical":"x^{2}_{1}", "fractions":0, "scripts":1},
    {"id":"scripted-fraction", "source":"\\frac{a}{b}^{c_d}", "expect":"supported", "canonical":"\\frac{a}{b}^{c_{d}}", "fractions":1, "scripts":2},
    {"id":"minimum-ime-target", "source":"\\frac{x_1+\\text{速度}}{y^2}", "expect":"supported", "canonical":"\\frac{x_{1}+\\text{速度}}{y^{2}}", "fractions":1, "scripts":2},
    {"id":"repeated-distinct-identities", "source":"\\frac{x}{y}+\\frac{x}{y}", "expect":"supported", "canonical":"\\frac{x}{y}+\\frac{x}{y}", "fractions":2, "scripts":0},
    {"id":"grouping-preserved", "source":"{{a+b}}", "expect":"supported", "canonical":"{{a+b}}", "fractions":0, "scripts":0},
    {"id":"greek-boundary", "source":"\\alpha x+\\beta y", "expect":"supported", "canonical":"\\alpha x+\\beta y", "fractions":0, "scripts":0},
    {"id":"greek-scripted-boundary", "source":"\\alpha x^2", "expect":"supported", "canonical":"\\alpha x^{2}", "fractions":0, "scripts":1},
    {"id":"escaped-delimiters", "source":"\\{x\\}", "expect":"supported", "canonical":"\\{x\\}", "fractions":0, "scripts":0},
    {"id":"comment-versus-percent", "source":"a\\%+b%ignored { }\\frac\r\n+c", "expect":"supported", "canonical":"a\\%+b+c", "fractions":0, "scripts":0},
    {"id":"text-spaces", "source":"\\text{two  spaces 速度}", "expect":"supported", "canonical":"\\text{two  spaces 速度}", "fractions":0, "scripts":0},
    {"id":"text-graphemes", "source":"\\text{é 👩‍🔬 🇨🇳}", "expect":"supported", "fractions":0, "scripts":0},
    {"id":"text-specials", "source":"\\text{50\\% \\{x\\} a\\_b}", "expect":"supported", "fractions":0, "scripts":0},
    {"id":"empty-slots", "source":"\\frac{}{}", "expect":"supported", "canonical":"\\frac{}{}", "fractions":1, "scripts":0, "unfilled":true},
    {"id":"missing-denominator", "source":"\\frac{a}", "expect":"incomplete"},
    {"id":"unfinished-denominator", "source":"\\frac{a}{", "expect":"incomplete"},
    {"id":"unfinished-script", "source":"x_", "expect":"incomplete"},
    {"id":"unfinished-group", "source":"{x", "expect":"incomplete"},
    {"id":"unfinished-text", "source":"\\text{速度", "expect":"incomplete"},
    {"id":"unfinished-command", "source":"\\", "expect":"incomplete"},
    {"id":"unmatched-close", "source":"x}", "expect":"invalid"},
    {"id":"double-superscript", "source":"x^1^2", "expect":"invalid"},
    {"id":"no-script-base", "source":"^2", "expect":"invalid"},
    {"id":"unknown-macro", "source":"\\futureCommand{a}{b}", "expect":"unsupported"},
    {"id":"physics-macro-p09", "source":"\\pdv{f}{x}", "expect":"supported", "canonical":"\\pdv{f}{x}", "fractions":0, "scripts":0},
    {"id":"radical-p07", "source":"\\sqrt{x}", "expect":"supported", "canonical":"\\sqrt{x}", "fractions":0, "scripts":0},
    {"id":"accent-promoted-supported", "source":"\\hat{x}", "expect":"supported", "fractions":0, "scripts":0},
    {"id":"unknown-accent-preserved", "source":"\\futureaccent{x}", "expect":"unsupported"},
    {"id":"matrix-p08", "source":"\\begin{matrix}a&b\\\\c&d\\end{matrix}", "expect":"supported", "fractions":0, "scripts":0},
    {"id":"input-never-executed", "source":"\\input{secret-file.tex}", "expect":"unsupported"},
    {"id":"shell-never-executed", "source":"\\write18{do-not-run}", "expect":"unsupported"},
    {"id":"macro-definition-never-executed", "source":"\\def\\foo{a}\\foo", "expect":"unsupported"}
  ]
}
