/**
 * Builds the command-frequency table that ranks editor completions.
 *
 * Method (Overleaf, "A data-driven approach to LaTeX autocomplete", 2017):
 * for every document d the local frequency of command c is
 * f(c,d) = n(c,d) / N(d); the global score is the mean of f(c,d) over all
 * documents (documents without c contribute 0), so a command used by many
 * documents outranks one used heavily by a few. Here a "document" is one
 * formula. Scores are scaled by 100 as in Overleaf's snippet table.
 *
 * Corpus: im2latex-100k (formulas from arXiv papers, one per line),
 * https://zenodo.org/record/56198/files/im2latex_formulas.lst
 *
 *   npx tsx scripts/build_command_frequency.mts --corpus=path/to/im2latex_formulas.lst
 */
import { readFileSync, writeFileSync } from "node:fs";

const argument = (name: string) =>
  process.argv.find((value) => value.startsWith(`--${name}=`))?.slice(name.length + 3);

// Old TeX spellings count as the command the editor offers for them.
const SYNONYMS: Record<string, string> = {
  "\\over": "\\frac",
  "\\rm": "\\mathrm",
  "\\bf": "\\mathbf",
  "\\cal": "\\mathcal",
  "\\it": "\\mathit",
  "\\lbrace": "\\{",
  "\\rbrace": "\\}",
};
// Structural tokens that are never typed through completion.
const IGNORED = new Set(["\\end", "\\label", "\\nonumber", "\\left", "\\right"]);

function commandCounts(latex: string) {
  const counts = new Map<string, number>();
  const add = (command: string) => {
    const name = SYNONYMS[command] ?? command;
    if (!IGNORED.has(name)) counts.set(name, (counts.get(name) ?? 0) + 1);
  };
  for (const match of latex.matchAll(/\\begin\s*\{([A-Za-z*]+)\}|\\([A-Za-z]+)/g)) {
    if (match[1]) add(`\\begin{${match[1]}}`);
    else if (match[2] !== "begin") add(`\\${match[2]}`);
  }
  return counts;
}

const corpus = argument("corpus");
if (!corpus) throw new Error("--corpus is required");

const sums = new Map<string, number>();
let documents = 0;
for (const line of readFileSync(corpus, "utf8").split(/\r?\n/)) {
  const counts = commandCounts(line);
  let total = 0;
  for (const n of counts.values()) total += n;
  if (!total) continue;
  documents++;
  for (const [command, n] of counts) sums.set(command, (sums.get(command) ?? 0) + n / total);
}

const entries = [...sums]
  .map(([command, sum]) => [command, (100 * sum) / documents] as const)
  .filter(([, score]) => score >= 0.0005)
  .sort((a, b) => b[1] - a[1])
  .map(([command, score]) => [command, Number(score.toFixed(4))] as const);

const out = argument("out") ?? "src/autocomplete/commandFrequency.generated.ts";
writeFileSync(
  out,
  [
    "// Generated by scripts/build_command_frequency.mts. Do not edit.",
    `// Corpus: im2latex-100k (arXiv formulas), ${documents} formulas.`,
    "// Score: Overleaf mean per-formula command frequency x 100.",
    "export const COMMAND_FREQUENCY: Readonly<Record<string, number>> = {",
    ...entries.map(([command, score]) => `  ${JSON.stringify(command)}: ${score},`),
    "};",
    "",
  ].join("\n"),
);
console.log(`${documents} formulas, ${entries.length} commands`);
console.log(entries.slice(0, 40).map(([c, s]) => `${c} ${s}`).join("  "));
