<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="VTPowerPointRibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="VisualTeX.Mac.PowerPoint.Tab"
           label="VisualTeX"
           insertAfterMso="TabInsert">
        <group id="VisualTeX.Mac.PowerPoint.NativeGroup" label="原生公式">
          <button id="VisualTeX.Mac.PowerPoint.InlineOmml"
                  label="行内 OMML"
                  size="large"
                  imageMso="EquationInsertNew"
                  onAction="VTPowerPointRibbonInlineOmml"
                  screentip="插入行内原生公式"
                  supertip="在文本框当前光标或选区插入可由 PowerPoint 原生编辑的 OMML 公式，保留前后文字；没有文本光标时新建独立公式。"/>
          <button id="VisualTeX.Mac.PowerPoint.DisplayOmml"
                  label="行间 OMML"
                  size="large"
                  imageMso="EquationInsertNew"
                  onAction="VTPowerPointRibbonDisplayOmml"
                  screentip="插入行间原生公式"
                  supertip="在当前文本框内插入独立居中的原生公式段落，不另建文本框；没有文本光标时新建独立公式。"/>
        </group>
        <group id="VisualTeX.Mac.PowerPoint.Group" label="公式工具">
          <button id="VisualTeX.Mac.PowerPoint.New"
                  label="新建公式"
                  size="large"
                  image="VisualTeXIcon05"
                  onAction="VTPowerPointRibbonNew"/>
          <button id="VisualTeX.Mac.PowerPoint.Edit"
                  label="编辑所选公式"
                  size="large"
                  image="VisualTeXIcon07"
                  onAction="VTPowerPointRibbonEdit"/>
          <button id="VisualTeX.Mac.PowerPoint.Delete"
                  label="删除所选公式"
                  size="normal"
                  imageMso="Delete"
                  onAction="VTPowerPointRibbonDelete"/>
          <dropDown id="VisualTeX.Mac.PowerPoint.FormulaFontSize"
                    label="SVG 公式字号"
                    sizeString="自定义（512 pt）"
                    getItemCount="VTPowerPointRibbonGetFormulaFontSizeItemCount"
                    getItemLabel="VTPowerPointRibbonGetFormulaFontSizeItemLabel"
                    getSelectedItemIndex="VTPowerPointRibbonGetFormulaFontSizeSelectedIndex"
                    onAction="VTPowerPointRibbonApplyFormulaFontSizePreset"
                    screentip="选择 SVG 公式字号"
                    supertip="先选中一个或多个 VisualTeX SVG 公式，再从中文字号和磅值列表中选择；选择后立即应用，并保持中心、旋转和层级不变。"/>
          <button id="VisualTeX.Mac.PowerPoint.Open"
                  label="打开 VisualTeX"
                  size="normal"
                  imageMso="FileOpen"
                  onAction="VTPowerPointRibbonOpen"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
