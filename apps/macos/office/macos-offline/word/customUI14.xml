<?xml version="1.0" encoding="UTF-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui"
          onLoad="VTWordRibbonOnLoad">
  <ribbon>
    <tabs>
      <tab id="VisualTeX.Mac.Word.Tab"
           label="VisualTeX"
           insertAfterMso="TabInsert">
        <group id="VisualTeX.Mac.Word.Group" label="公式">
          <button id="VisualTeX.Mac.Word.Inline"
                  label="图片行内公式"
                  size="large"
                  image="VisualTeXWordImageInline"
                  onAction="VTWordRibbonInline"/>
          <button id="VisualTeX.Mac.Word.Display"
                  label="图片行间公式"
                  size="large"
                  image="VisualTeXWordImageDisplay"
                  onAction="VTWordRibbonDisplay"/>
          <button id="VisualTeX.Mac.Word.NativeInline"
                  label="OMML 行内公式"
                  size="large"
                  image="VisualTeXWordOmmlInline"
                  onAction="VTWordRibbonNativeInline"
                  screentip="插入 Word 原生行内公式"
                  supertip="插入可由 Word 原生公式工具直接编辑、同时保留 VisualTeX LaTeX 元数据的 OMML 行内公式。"/>
          <button id="VisualTeX.Mac.Word.NativeDisplay"
                  label="OMML 行间公式"
                  size="large"
                  image="VisualTeXWordOmmlDisplay"
                  onAction="VTWordRibbonNativeDisplay"
                  screentip="插入 Word 原生行间公式"
                  supertip="插入可由 Word 原生公式工具直接编辑、同时保留 VisualTeX LaTeX 元数据的 OMML 行间公式。"/>
          <button id="VisualTeX.Mac.Word.Edit"
                  label="编辑所选公式"
                  size="large"
                  image="VisualTeXWordEditSelected"
                  onAction="VTWordRibbonEdit"/>

        </group>

        <!-- Small controls one after another, without boxes: Word for Mac stacks them three to a column, as its own
             SmartArt / Chart / Screenshot (a box becomes a row). -->
        <group id="VisualTeX.Mac.Word.ToolsGroup" label="转换与编号">
          <menu id="VisualTeX.Mac.Word.ConvertSelectionFormat"
                label="所选格式转换"
                image="VisualTeXWordConvertSelection"
                screentip="转换所选公式的格式"
                supertip="把所选的 VisualTeX 图片公式转为 Word OMML，或把所选的 Word OMML 公式转为 VisualTeX 图片公式；保留公式身份、字号、编号和引用。">
            <button id="VisualTeX.Mac.Word.ConvertNative"
                    label="转为 Word OMML"
                    onAction="VTWordRibbonConvertNative"
                    screentip="转换为 Word 原生公式"
                    supertip="将所选 VisualTeX 图片公式直接转换为 Word 原生 OMML，并保留 VisualTeX 元数据。"/>
            <button id="VisualTeX.Mac.Word.ConvertImage"
                    label="转为图片公式"
                    onAction="VTWordRibbonConvertImage"
                    screentip="直接转换为 VisualTeX 图片公式"
                    supertip="将所选 Word OMML 公式在后台直接转换为 VisualTeX 图片公式，不打开公式编辑窗口。"/>
          </menu>
          <menu id="VisualTeX.Mac.Word.ConvertDocumentFormat"
                label="全文格式转换"
                image="VisualTeXWordConvertDocument"
                screentip="转换全文公式格式"
                supertip="在当前 Word 文档中批量转换 VisualTeX 图片公式与 Word OMML；保留公式身份、字号、编号和引用。">
            <button id="VisualTeX.Mac.Word.ConvertDocumentImagesToOmml"
                    label="全文图片公式 → Word OMML"
                    onAction="VTWordRibbonConvertDocumentImagesToOmml"/>
            <button id="VisualTeX.Mac.Word.ConvertDocumentOmmlToImages"
                    label="全文 OMML → 图片公式"
                    onAction="VTWordRibbonConvertDocumentOmmlToImages"/>
          </menu>
          <button id="VisualTeX.Mac.Word.UpdateEquationFormat"
                  label="更新公式格式"
                  image="VisualTeXWordUpdateFormat"
                  onAction="VTWordRibbonUpdateEquationFormat"
                  screentip="更新公式格式"
                  supertip="把本文档中旧版 VisualTeX 写入的公式编号与标记一次升级为当前格式（与 Windows 版相同），并应用“OMML 字体”的选择，让所有 OMML 公式统一使用文档数学字体。公式内容不变，可一步撤销。"/>
          <button id="VisualTeX.Mac.Word.Numbering"
                  label="更新公式编号"
                  image="VisualTeXWordUpdateNumbers"
                  onAction="VTWordRibbonNumbering"/>
          <menu id="VisualTeX.Mac.Word.NumberingFormat"
                label="编号格式"
                image="VisualTeXWordNumberingFormat"
                screentip="选择公式编号格式"
                supertip="从下拉菜单直接选择完整编号格式。选择后立即重建当前文档中的 OMML 与图片公式编号结构，两套序列仍分别计数，并记为后续新文档的默认格式。">
            <button id="VisualTeX.Mac.Word.NumberingFormat.Sequence"
                    label="顺序编号 (1)"
                    onAction="VTWordRibbonNumberingFormatSequence"/>
            <button id="VisualTeX.Mac.Word.NumberingFormat.ChapterDot"
                    label="按章编号 (2.1)"
                    onAction="VTWordRibbonNumberingFormatChapterDot"/>
            <button id="VisualTeX.Mac.Word.NumberingFormat.ChapterDash"
                    label="按章编号 (2-1)"
                    onAction="VTWordRibbonNumberingFormatChapterDash"/>
            <button id="VisualTeX.Mac.Word.NumberingFormat.SectionDot"
                    label="按节编号 (2.3.1)"
                    onAction="VTWordRibbonNumberingFormatSectionDot"/>
            <button id="VisualTeX.Mac.Word.NumberingFormat.SectionDash"
                    label="按节编号 (2.3-1)"
                    onAction="VTWordRibbonNumberingFormatSectionDash"/>
          </menu>
          <dynamicMenu id="VisualTeX.Mac.Word.CrossReference"
                       label="插入公式引用"
                       image="VisualTeXWordCrossReference"
                       getContent="VTWordRibbonCrossReferenceMenuContent"
                       invalidateContentOnDrop="true"
                       screentip="引用带编号公式"
                       supertip="分别展开当前文档中的 Word OMML 与图片公式编号列表；点击目标公式后插入可自动更新的 Word REF 字段。"/>
          <menu id="VisualTeX.Mac.Word.BatchNumbering"
                label="批量编号"
                image="VisualTeXWordBatchNumbering"
                screentip="为行间公式批量添加编号"
                supertip="按当前编号格式，为所选内容或全文中所有未编号的行间公式（VisualTeX 图片公式、Word OMML）添加各自的编号；已有编号保持不变并自动顺延，交叉引用同步更新，可一步撤销。">
            <button id="VisualTeX.Mac.Word.BatchNumberingSelection"
                    label="为所选行间公式编号"
                    onAction="VTWordRibbonNumberDisplayFormulasSelection"/>
            <button id="VisualTeX.Mac.Word.BatchNumberingDocument"
                    label="为全文行间公式编号"
                    onAction="VTWordRibbonNumberDisplayFormulasDocument"/>
          </menu>
          <button id="VisualTeX.Mac.Word.DocumentImport"
                  label="批量导入"
                  image="VisualTeXWordDocumentImport"
                  onAction="VTWordRibbonDocumentImport"
                  screentip="批量导入 LaTeX / Markdown"
                  supertip="将 Markdown 或 LaTeX 文档解析为 Word 原生文字，以及可单独编辑和调整字号的行内、行间公式。"/>
          <button id="VisualTeX.Mac.Word.Open"
                  label="打开 VisualTeX"
                  image="VisualTeXWordOpenApp"
                  onAction="VTWordRibbonOpen"/>
        </group>

        <group id="VisualTeX.Mac.Word.RedrawGroup" label="LaTeX 重绘">
          <menu id="VisualTeX.Mac.Word.RedrawSelection"
                label="重绘所选"
                size="large"
                image="VisualTeXWordRedrawSelection"
                screentip="重绘所选 LaTeX 代码"
                supertip="识别所选文字中的 $...$、$$...$$、\(...\)、\[...\] 和常见公式环境，并在原位置换为可编辑公式。">
            <button id="VisualTeX.Mac.Word.RedrawSelectionOmml"
                    label="重绘为 Word OMML"
                    onAction="VTWordRibbonRedrawSelectionOmml"/>
            <button id="VisualTeX.Mac.Word.RedrawSelectionImage"
                    label="重绘为 VisualTeX 图片公式"
                    onAction="VTWordRibbonRedrawSelectionImage"/>
            <menuSeparator id="VisualTeX.Mac.Word.RedrawSelectionRestoreSeparator"/>
            <button id="VisualTeX.Mac.Word.RestoreSelectionOmmlToLatex"
                    label="将 OMML 公式转为 LaTeX"
                    onAction="VTWordRibbonRestoreSelectionOmmlToLatex"
                    screentip="恢复所选 Word 原生公式"
                    supertip="读取所选公式当前的 Word OMML 结构并原位恢复为 LaTeX；同时支持 Word 原生公式编辑器和 VisualTeX 创建的 OMML。"/>
            <button id="VisualTeX.Mac.Word.RestoreSelectionImageToLatex"
                    label="将图片公式转为 LaTeX"
                    onAction="VTWordRibbonRestoreSelectionImageToLatex"
                    screentip="恢复所选 VisualTeX 图片公式"
                    supertip="读取所选 VisualTeX 图片公式的可恢复元数据，并在原位置恢复为 LaTeX。"/>
          </menu>
          <menu id="VisualTeX.Mac.Word.RedrawDocument"
                label="重绘全文"
                size="large"
                image="VisualTeXWordRedrawDocument"
                screentip="重绘整个文档中的 LaTeX 代码"
                supertip="选择输出格式后扫描当前 Word 正文，并在原位置换全部 LaTeX 公式。">
            <button id="VisualTeX.Mac.Word.RedrawDocumentOmml"
                    label="全文重绘为 Word OMML"
                    onAction="VTWordRibbonRedrawDocumentOmml"/>
            <button id="VisualTeX.Mac.Word.RedrawDocumentImage"
                    label="全文重绘为 VisualTeX 图片公式"
                    onAction="VTWordRibbonRedrawDocumentImage"/>
            <menuSeparator id="VisualTeX.Mac.Word.RedrawDocumentRestoreSeparator"/>
            <button id="VisualTeX.Mac.Word.RestoreDocumentOmmlToLatex"
                    label="将全文 OMML 公式转为 LaTeX"
                    onAction="VTWordRibbonRestoreDocumentOmmlToLatex"
                    screentip="恢复全文 Word 原生公式"
                    supertip="扫描全文全部 Word OMML 公式并原位恢复为 LaTeX；同时支持 Word 原生公式编辑器和 VisualTeX 创建的 OMML。"/>
            <button id="VisualTeX.Mac.Word.RestoreDocumentImageToLatex"
                    label="将全文图片公式转为 LaTeX"
                    onAction="VTWordRibbonRestoreDocumentImageToLatex"
                    screentip="恢复全文 VisualTeX 图片公式"
                    supertip="扫描全文可恢复的 VisualTeX 图片公式，并在原位置恢复为 LaTeX。普通图片不会被处理。"/>
          </menu>
        </group>

        <group id="VisualTeX.Mac.Word.FontSizeGroup" label="公式字号">
          <dropDown id="VisualTeX.Mac.Word.ImageFontSize"
                    label="所选公式字号"
                    sizeString="自定义（512 pt）"
                    getItemCount="VTWordRibbonGetImageFontSizeItemCount"
                    getItemLabel="VTWordRibbonGetImageFontSizeItemLabel"
                    getSelectedItemIndex="VTWordRibbonGetImageFontSizeSelectedIndex"
                    onAction="VTWordRibbonApplyImageFontSizePreset"
                    screentip="选择图片公式字号"
                    supertip="先选中一个或多个 VisualTeX 图片公式，再从中文字号和磅值列表中选择；选择后立即应用。"/>
          <dropDown id="VisualTeX.Mac.Word.InlineConversionFontSize"
                    label="行内公式字号"
                    sizeString="自定义（512 pt）"
                    getItemCount="VTWordRibbonGetConversionFontSizeItemCount"
                    getItemLabel="VTWordRibbonGetConversionFontSizeItemLabel"
                    getSelectedItemIndex="VTWordRibbonGetConversionFontSizeSelectedIndex"
                    onAction="VTWordRibbonApplyConversionFontSize"
                    screentip="行内公式字号"
                    supertip="选择字号后，当前文档中所有行内公式（VisualTeX 图片公式和 Word 公式）立即改为这个字号，可以撤销。之后 LaTeX 重绘、批量导入和格式转换生成的行内公式也使用这个字号。选“跟随正文”不改动现有公式。"/>
          <dropDown id="VisualTeX.Mac.Word.DisplayConversionFontSize"
                    label="行间公式字号"
                    sizeString="自定义（512 pt）"
                    getItemCount="VTWordRibbonGetConversionFontSizeItemCount"
                    getItemLabel="VTWordRibbonGetConversionFontSizeItemLabel"
                    getSelectedItemIndex="VTWordRibbonGetConversionFontSizeSelectedIndex"
                    onAction="VTWordRibbonApplyConversionFontSize"
                    screentip="行间公式字号"
                    supertip="选择字号后，当前文档中所有行间公式（VisualTeX 图片公式和 Word 公式）立即改为这个字号，可以撤销。之后 LaTeX 重绘、批量导入和格式转换生成的行间公式也使用这个字号。选“跟随正文”不改动现有公式。"/>
          <menu id="VisualTeX.Mac.Word.OmmlFont"
                label="OMML 字体"
                size="large"
                image="VisualTeXWordOmmlFont"
                screentip="OMML 公式字体"
                supertip="选择 Word 原生公式（OMML）使用的数学字体。选择后当前文档的数学字体立即改为这个字体，现有 OMML 公式一起改用它，可一步撤销；之后 VisualTeX 写入的 OMML 公式也使用它。设置对所有文档生效。选“跟随文档”不改动文档。STIX Two Math、Latin Modern Math 和 TeX Gyre Termes Math 随 VisualTeX Office 插件安装，新装后重新启动 Word 即可选择。">
            <toggleButton id="VisualTeX.Mac.Word.OmmlFont.Follow"
                          label="跟随文档（不更改）"
                          getPressed="VTWordRibbonGetOmmlFontPressed"
                          onAction="VTWordRibbonSelectOmmlFont"/>
            <toggleButton id="VisualTeX.Mac.Word.OmmlFont.Cambria"
                          label="Cambria Math"
                          getPressed="VTWordRibbonGetOmmlFontPressed"
                          onAction="VTWordRibbonSelectOmmlFont"/>
            <toggleButton id="VisualTeX.Mac.Word.OmmlFont.Stix"
                          getLabel="VTWordRibbonGetOmmlFontLabel"
                          getEnabled="VTWordRibbonGetOmmlFontEnabled"
                          getPressed="VTWordRibbonGetOmmlFontPressed"
                          onAction="VTWordRibbonSelectOmmlFont"/>
            <toggleButton id="VisualTeX.Mac.Word.OmmlFont.LatinModern"
                          getLabel="VTWordRibbonGetOmmlFontLabel"
                          getEnabled="VTWordRibbonGetOmmlFontEnabled"
                          getPressed="VTWordRibbonGetOmmlFontPressed"
                          onAction="VTWordRibbonSelectOmmlFont"/>
            <toggleButton id="VisualTeX.Mac.Word.OmmlFont.Termes"
                          getLabel="VTWordRibbonGetOmmlFontLabel"
                          getEnabled="VTWordRibbonGetOmmlFontEnabled"
                          getPressed="VTWordRibbonGetOmmlFontPressed"
                          onAction="VTWordRibbonSelectOmmlFont"/>
          </menu>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
