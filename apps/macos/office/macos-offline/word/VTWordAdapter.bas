                wdRelativeVerticalPositionPage
            floatingPicture.Left = 180
            floatingPicture.Top = 180
            floatingPicture.Width = 72
            floatingPicture.Height = 36
            floatingPicture.Select
        Case Else
            inlinePicture.Title = ""
            inlinePicture.AlternativeText = ""
