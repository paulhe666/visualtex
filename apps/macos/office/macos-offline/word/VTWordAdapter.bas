Private Function VTWordRibbonXmlAttribute( _
    ByVal value As String) As String

    value = Replace$(value, "&", "&amp;")
    value = Replace$(value, """", "&quot;")
    value = Replace$(value, "<", "&lt;")
    value = Replace$(value, ">", "&gt;")
    VTWordRibbonXmlAttribute = value
End Function

