<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <!-- The same tab as the Word for Mac add-in's (word/customUI14.xml): the same groups, the same buttons in the same
       order, large where Word's are large and in columns of three where Word stacks small controls three to a column,
       and Word's names with WPS's own equations called "WPS 公式" where Word says OMML. WPS shows no group or menu
       section titles. How WPS lays boxes out (12.1, Windows and Mac): it packs side-by-side vertical boxes into one
       column, so each column is a vertical box of its own and a group's columns stand in a horizontal box, and it
       centres a column's controls, so the columns side by side have the same number of rows. The sizes are menus with
       the current value ticked:
       WPS for Mac shows no value in a drop-down box. The icons are WPS's own (imageMso names WPS for Mac ships, which
       differ from Windows WPS's), chosen by what they show. WPS for Mac draws a large label on one line (Windows WPS's
       enableLineBreak is missing), so the large formula buttons say it short, without "公式" (图片行内, WPS行内, 编辑所选)
       and without spaces (WPS for Mac once broke a large label at a space and hid the icon); their screentips keep the
       full names. -->
  <ribbon>
    <tabs>
      <tab id="VisualTeXTab" label="VisualTeX" insertAfterMso="TabHome">
        <group id="VisualTeXFormulaGroup" label="公式">
          <button id="vtxImageInline" label="图片行内" size="large" screentip="插入 VisualTeX 图片行内公式" supertip="在光标处插入 VisualTeX 图片行内公式；双击即可再次编辑。" imageMso="EquationScriptGallery" onAction="OnVisualTeXAction" />
          <button id="vtxImageDisplay" label="图片行间" size="large" screentip="插入 VisualTeX 图片行间公式" supertip="在单独的居中段落插入 VisualTeX 图片行间公式；双击即可再次编辑。" imageMso="EquationFractionGallery" onAction="OnVisualTeXAction" />
          <button id="vtxOmmlInline" label="WPS行内" size="large" screentip="插入 WPS 行内公式" supertip="在 VisualTeX 编辑器中写好后，在光标处插入 WPS 自己的公式（OMML），之后也能用 WPS 的公式工具编辑。" imageMso="EquationProfessional" onAction="OnVisualTeXAction" />
          <button id="vtxOmmlDisplay" label="WPS行间" size="large" screentip="插入 WPS 行间公式" supertip="在 VisualTeX 编辑器中写好后，插入 WPS 自己的行间公式（OMML），之后也能用 WPS 的公式工具编辑。" imageMso="EquationInsertGallery" onAction="OnVisualTeXAction" />
          <button id="vtxEditSelected" label="编辑所选" size="large" screentip="编辑所选公式" supertip="在 VisualTeX 编辑器中编辑所选的 VisualTeX 图片公式或 WPS 公式；也可以双击公式。" imageMso="KSEquationEditor" onAction="OnVisualTeXAction" />
        </group>
        <group id="VisualTeXToolsGroup" label="转换与编号">
          <box id="vtxToolsColumns" boxStyle="horizontal">
            <box id="vtxConvertColumn" boxStyle="vertical">
              <menu id="vtxConvertSelectionMenu" label="所选格式转换" screentip="转换所选公式的格式" supertip="把所选的 VisualTeX 图片公式转为 WPS 公式，或把所选的 WPS 公式转为 VisualTeX 图片公式；保留公式身份、字号、编号和引用。" imageMso="EquationTransferOMML">
                <button id="vtxConvertNative" label="转为 WPS 公式" onAction="OnVisualTeXAction" />
                <button id="vtxConvertImage" label="转为图片公式" onAction="OnVisualTeXAction" />
              </menu>
              <menu id="vtxConvertDocumentMenu" label="全文格式转换" screentip="转换全文公式格式" supertip="在当前文档中批量转换 VisualTeX 图片公式与 WPS 公式；保留公式身份、字号、编号和引用。" imageMso="Convert">
                <button id="vtxConvertDocumentImagesToOmml" label="全文图片公式 → WPS 公式" onAction="OnVisualTeXAction" />
                <button id="vtxConvertDocumentOmmlToImages" label="全文 WPS 公式 → 图片公式" onAction="OnVisualTeXAction" />
              </menu>
              <button id="vtxUpdateEquationFormat" label="更新公式格式" screentip="更新公式格式" supertip="把本文档中旧版 VisualTeX 写入的公式编号与标记一次升级为当前格式；字体与当前设置不同的 VisualTeX 图片公式按 LaTeX 用当前字体重绘。公式内容、编号、引用和字号不变，可一步撤销。" imageMso="Refresh" onAction="OnVisualTeXAction" />
            </box>
            <box id="vtxNumberingColumn" boxStyle="vertical">
              <button id="vtxUpdateNumbers" label="更新公式编号" screentip="更新公式编号" supertip="重新计算当前文档中 WPS 公式与 VisualTeX 图片公式的编号，并更新对它们的引用。" imageMso="UpdateField" onAction="OnVisualTeXAction" />
              <menu id="vtxNumberingFormat" label="编号格式" screentip="公式编号格式" supertip="选择后立即重排当前文档中 WPS 公式与 VisualTeX 图片公式的编号（两类公式分别计数），并作为之后新文档的默认格式。" imageMso="SmartPageNumber">
                <button id="vtxNumberingSequence" label="顺序编号 (1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingChapterDot" label="按章编号 (2.1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingChapterDash" label="按章编号 (2-1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingSectionDot" label="按节编号 (2.3.1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingSectionDash" label="按节编号 (2.3-1)" onAction="OnVisualTeXAction" />
              </menu>
              <dynamicMenu id="vtxCrossReference" label="插入公式引用" screentip="插入公式引用" supertip="列出当前文档中带编号的公式；点击一个，在光标处插入随编号自动更新的引用。" imageMso="CrossReference" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
            </box>
            <box id="vtxBatchColumn" boxStyle="vertical">
              <menu id="vtxBatchNumbering" label="批量编号" screentip="为行间公式批量添加编号" supertip="按当前编号格式，为所选范围或全文中没有编号的行间公式添加编号；已有编号保持不变并自动顺延，引用随之更新，可一步撤销。" imageMso="Numbering">
                <button id="vtxNumberSelection" label="为所选行间公式编号" onAction="OnVisualTeXAction" />
                <button id="vtxNumberDocument" label="为全文行间公式编号" onAction="OnVisualTeXAction" />
              </menu>
              <button id="vtxDocumentImport" label="批量导入" screentip="批量导入 LaTeX / Markdown" supertip="选择一个 LaTeX 或 Markdown 文档，正文插入为文字，公式插入为可编辑、可调字号的行内和行间公式。" imageMso="OpenFile" onAction="OnVisualTeXAction" />
              <button id="vtxOpen" label="打开 VisualTeX" screentip="打开 VisualTeX 主窗口" imageMso="EquationOptions" onAction="OnVisualTeXAction" />
            </box>
          </box>
        </group>
        <group id="VisualTeXRedrawGroup" label="LaTeX 重绘">
          <menu id="vtxRedrawSelectionMenu" label="重绘所选" size="large" screentip="重绘所选 LaTeX 代码" supertip="识别所选文字中的 $…$、$$…$$、\(…\)、\[…\] 和常见公式环境，并在原位置换为可编辑公式；也可把所选公式换回 LaTeX 代码。" imageMso="EquationInsertLaTex">
            <button id="vtxRedrawSelectionOmml" label="重绘为 WPS 公式" onAction="OnVisualTeXAction" />
            <button id="vtxRedrawSelectionImage" label="重绘为 VisualTeX 图片公式" onAction="OnVisualTeXAction" />
            <menuSeparator id="vtxRedrawSelectionRestoreSeparator" />
            <button id="vtxRestoreSelectionOmml" label="将 WPS 公式转为 LaTeX" onAction="OnVisualTeXAction" />
            <button id="vtxRestoreSelectionImage" label="将图片公式转为 LaTeX" onAction="OnVisualTeXAction" />
          </menu>
          <menu id="vtxRedrawDocumentMenu" label="重绘全文" size="large" screentip="重绘整个文档中的 LaTeX 代码" supertip="选择输出格式后扫描当前文档正文，并在原位置换全部 LaTeX 公式；也可把全文公式换回 LaTeX 代码。" imageMso="EquationTransferLaTex">
            <button id="vtxRedrawDocumentOmml" label="全文重绘为 WPS 公式" onAction="OnVisualTeXAction" />
            <button id="vtxRedrawDocumentImage" label="全文重绘为 VisualTeX 图片公式" onAction="OnVisualTeXAction" />
            <menuSeparator id="vtxRedrawDocumentRestoreSeparator" />
            <button id="vtxRestoreDocumentOmml" label="将全文 WPS 公式转为 LaTeX" onAction="OnVisualTeXAction" />
            <button id="vtxRestoreDocumentImage" label="将全文图片公式转为 LaTeX" onAction="OnVisualTeXAction" />
          </menu>
        </group>
        <group id="VisualTeXFontSizeGroup" label="公式字号">
          <box id="vtxSizeColumn" boxStyle="vertical">
            <dynamicMenu id="vtxImageFontSize" label="所选公式字号" screentip="所选公式字号" supertip="先选中一个或多个 VisualTeX 图片公式，再选择字号；立即应用。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
            <dynamicMenu id="vtxInlineConversionFontSize" label="行内公式字号" screentip="行内公式字号" supertip="选择后，当前文档中所有行内公式（VisualTeX 图片公式和 WPS 公式）立即改为这个字号，可以撤销；之后转换、LaTeX 重绘和批量导入生成的行内公式也用这个字号。“跟随正文”不改动现有公式。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
            <dynamicMenu id="vtxDisplayConversionFontSize" label="行间公式字号" screentip="行间公式字号" supertip="选择后，当前文档中所有行间公式（VisualTeX 图片公式和 WPS 公式）立即改为这个字号，可以撤销；之后转换、LaTeX 重绘和批量导入生成的行间公式也用这个字号。“跟随正文”不改动现有公式。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
          </box>
          <dynamicMenu id="vtxOmmlFont" label="WPS公式字体" size="large" screentip="WPS 公式字体" supertip="VisualTeX 写入 WPS 公式时使用的数学字体。WPS 没有文档数学字体：所选字体用于之后 VisualTeX 插入、编辑、转换或重绘得到的 WPS 公式，已有公式在再次编辑后改用它。与 Word 的“OMML 字体”是同一个设置，对所有文档生效。STIX Two Math、Latin Modern Math 和 TeX Gyre Termes Math 随 VisualTeX 安装，新装后重新启动 WPS 即可使用。" imageMso="GroupFontSetting" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
        </group>
        <group id="VisualTeXRepairGroup" label="兼容修复">
          <button id="vtxRepairDisplayFormulas" label="修复行间" size="large" screentip="修复行间公式" imageMso="AlignCenter" onAction="OnVisualTeXAction" />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
