<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" onLoad="OnAddinLoad">
  <!-- The tab in WPS's own style. WPS shows no group titles and no menu section titles, so every name says what it
       does: a verb, what it acts on, and into what ("转为 WPS 公式", "LaTeX 代码转为公式"). The formats are named the
       same everywhere: VisualTeX 公式 (the add-in's picture formulas), WPS 公式 (WPS's own equations, OMML), LaTeX
       代码. Groups, left to right: insert and edit, numbering and references, formula format conversion, LaTeX code,
       sizes and tools. Everyday actions are direct buttons; the batch conversions, which also choose a scope, are
       menus with the scope spelled out in each item.
       How WPS lays the columns out (12.1, Windows and Mac): it packs consecutive vertical boxes into one column of up
       to four (the tab then grows taller than WPS's own), so a group's columns stand in a horizontal box; it centres
       a lone control between the two rows, so a lone control's column gets an empty label as its second row. The
       sizes are menus with the current size ticked: WPS for Mac shows no value in a drop-down box. The icons are
       WPS's own (imageMso names it ships), chosen by what they show. -->
  <ribbon>
    <tabs>
      <tab id="VisualTeXTab" label="VisualTeX" insertAfterMso="TabHome">
        <group id="VisualTeXFormulaGroup" label="插入与编辑">
          <button id="vtxImageInline" label="行内公式" size="large" screentip="插入 VisualTeX 行内公式" supertip="在光标处插入 VisualTeX 行内公式；双击即可再次编辑。" imageMso="EquationScriptGallery" onAction="OnVisualTeXAction" />
          <button id="vtxImageDisplay" label="行间公式" size="large" screentip="插入 VisualTeX 行间公式" supertip="在单独的居中段落插入 VisualTeX 行间公式；双击即可再次编辑。" imageMso="EquationFractionGallery" onAction="OnVisualTeXAction" />
          <box id="vtxOmmlBox" boxStyle="vertical">
            <button id="vtxOmmlInline" label="WPS 行内公式" screentip="插入 WPS 行内公式" supertip="在 VisualTeX 编辑器中写好后，在光标处插入 WPS 自己的公式（OMML），之后也能用 WPS 的公式工具编辑。" imageMso="EquationProfessional" onAction="OnVisualTeXAction" />
            <button id="vtxOmmlDisplay" label="WPS 行间公式" screentip="插入 WPS 行间公式" supertip="在 VisualTeX 编辑器中写好后，插入 WPS 自己的行间公式（OMML），之后也能用 WPS 的公式工具编辑。" imageMso="EquationInsertGallery" onAction="OnVisualTeXAction" />
          </box>
          <button id="vtxEditSelected" label="编辑公式" size="large" screentip="编辑所选公式" supertip="在 VisualTeX 编辑器中编辑所选的 VisualTeX 公式或 WPS 公式；也可以双击公式。" imageMso="KSEquationEditor" onAction="OnVisualTeXAction" />
        </group>
        <group id="VisualTeXNumberingGroup" label="编号与引用">
          <box id="vtxNumberingColumns" boxStyle="horizontal">
            <box id="vtxNumbersBox" boxStyle="vertical">
              <button id="vtxUpdateNumbers" label="更新编号" screentip="更新公式编号" supertip="重新计算当前文档中 WPS 公式与 VisualTeX 公式的编号，并更新对它们的引用。" imageMso="UpdateField" onAction="OnVisualTeXAction" />
              <menu id="vtxNumberingFormat" label="编号格式" screentip="公式编号格式" supertip="选择后立即重排当前文档中 WPS 公式与 VisualTeX 公式的编号（两类公式分别计数），并作为之后新文档的默认格式。" imageMso="MoreNumbering">
                <button id="vtxNumberingSequence" label="顺序编号 (1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingChapterDot" label="按章编号 (2.1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingChapterDash" label="按章编号 (2-1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingSectionDot" label="按节编号 (2.3.1)" onAction="OnVisualTeXAction" />
                <button id="vtxNumberingSectionDash" label="按节编号 (2.3-1)" onAction="OnVisualTeXAction" />
              </menu>
            </box>
            <box id="vtxReferenceBox" boxStyle="vertical">
              <dynamicMenu id="vtxCrossReference" label="插入公式引用" screentip="插入公式引用" supertip="列出当前文档中带编号的公式；点击一个，在光标处插入随编号自动更新的引用。" imageMso="CrossReference" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
              <menu id="vtxBatchNumbering" label="添加编号" screentip="给行间公式添加编号" supertip="按当前编号格式，给所选范围或全文中没有编号的行间公式添加编号；已有编号保持不变并自动顺延，引用随之更新，可一步撤销。" imageMso="Numbering">
                <button id="vtxNumberSelection" label="给所选行间公式编号" onAction="OnVisualTeXAction" />
                <button id="vtxNumberDocument" label="给全文行间公式编号" onAction="OnVisualTeXAction" />
              </menu>
            </box>
          </box>
        </group>
        <group id="VisualTeXConvertGroup" label="格式转换">
          <box id="vtxConvertBox" boxStyle="vertical">
            <menu id="vtxToOmmlMenu" label="转为 WPS 公式" screentip="公式转为 WPS 公式" supertip="把 VisualTeX 公式转为 WPS 自己的公式（OMML），已是 WPS 公式的不变；字号、编号与引用按当前文档设置，可一步撤销。" imageMso="EquationTransferOMML">
              <button id="vtxConvertNative" label="所选公式转为 WPS 公式" onAction="OnVisualTeXAction" />
              <button id="vtxConvertDocumentImagesToOmml" label="全文公式转为 WPS 公式" onAction="OnVisualTeXAction" />
            </menu>
            <menu id="vtxToVisualTeXMenu" label="转为 VisualTeX 公式" screentip="公式转为 VisualTeX 公式" supertip="把 WPS 公式转为 VisualTeX 公式，已是 VisualTeX 公式的不变；字号、编号与引用按当前文档设置，可一步撤销。" imageMso="exporttopicture32">
              <button id="vtxConvertImage" label="所选公式转为 VisualTeX 公式" onAction="OnVisualTeXAction" />
              <button id="vtxConvertDocumentOmmlToImages" label="全文公式转为 VisualTeX 公式" onAction="OnVisualTeXAction" />
            </menu>
          </box>
        </group>
        <group id="VisualTeXLatexGroup" label="LaTeX 代码">
          <box id="vtxLatexBox" boxStyle="vertical">
            <menu id="vtxLatexToFormula" label="LaTeX 代码转为公式" screentip="LaTeX 代码转为公式" supertip="把文档里写成文字的 LaTeX 公式（$…$、$$…$$、\(…\)、\[…\] 和常见公式环境）原位换成公式。" imageMso="EquationInsertLaTex">
              <button id="vtxRedrawSelectionImage" label="所选 LaTeX 代码转为 VisualTeX 公式" onAction="OnVisualTeXAction" />
              <button id="vtxRedrawSelectionOmml" label="所选 LaTeX 代码转为 WPS 公式" onAction="OnVisualTeXAction" />
              <menuSeparator id="vtxLatexToFormulaSeparator" />
              <button id="vtxRedrawDocumentImage" label="全文 LaTeX 代码转为 VisualTeX 公式" onAction="OnVisualTeXAction" />
              <button id="vtxRedrawDocumentOmml" label="全文 LaTeX 代码转为 WPS 公式" onAction="OnVisualTeXAction" />
            </menu>
            <menu id="vtxFormulaToLatex" label="公式转为 LaTeX 代码" screentip="公式转为 LaTeX 代码" supertip="把公式（VisualTeX 公式和 WPS 公式）原位换回 LaTeX 代码，之后可以再转回公式。" imageMso="EquationTransferLaTex">
              <button id="vtxRestoreSelectionAll" label="所选公式转为 LaTeX 代码" onAction="OnVisualTeXAction" />
              <button id="vtxRestoreDocumentAll" label="全文公式转为 LaTeX 代码" onAction="OnVisualTeXAction" />
            </menu>
          </box>
          <button id="vtxDocumentImport" label="导入文档" size="large" screentip="导入 LaTeX 或 Markdown 文档" supertip="选择一个 LaTeX 或 Markdown 文档，正文插入为文字，公式插入为可编辑、可调字号的行内和行间公式。" imageMso="OpenFile" onAction="OnVisualTeXAction" />
        </group>
        <group id="VisualTeXFontSizeGroup" label="字号与工具">
          <box id="vtxSizeColumns" boxStyle="horizontal">
            <box id="vtxKindSizeBox" boxStyle="vertical">
              <dynamicMenu id="vtxInlineConversionFontSize" label="行内公式字号" screentip="行内公式字号" supertip="选择后，当前文档中所有行内公式（VisualTeX 公式和 WPS 公式）立即改为这个字号，可以撤销；之后转换、LaTeX 代码转为公式和导入文档生成的行内公式也用这个字号。“跟随正文”不改动现有公式。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
              <dynamicMenu id="vtxDisplayConversionFontSize" label="行间公式字号" screentip="行间公式字号" supertip="选择后，当前文档中所有行间公式（VisualTeX 公式和 WPS 公式）立即改为这个字号，可以撤销；之后转换、LaTeX 代码转为公式和导入文档生成的行间公式也用这个字号。“跟随正文”不改动现有公式。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
            </box>
            <box id="vtxSelectedSizeBox" boxStyle="vertical">
              <dynamicMenu id="vtxImageFontSize" label="所选公式字号" screentip="所选公式字号" supertip="先选中一个或多个 VisualTeX 公式，再选择字号；立即应用。" imageMso="FontSizeQat" getContent="OnVisualTeXMenuContent" invalidateContentOnDrop="true" />
              <labelControl id="vtxSelectedSizeRow2" label="　" />
            </box>
            <box id="vtxToolsBox" boxStyle="vertical">
              <button id="vtxUpdateEquationFormat" label="升级旧版公式" screentip="升级旧版公式" supertip="把本文档中旧版 VisualTeX 写入的公式编号与标记一次升级为当前格式。公式内容不变，可一步撤销。" imageMso="Refresh" onAction="OnVisualTeXAction" />
              <button id="vtxOpen" label="打开 VisualTeX" screentip="打开 VisualTeX 主窗口" imageMso="EquationOptions" onAction="OnVisualTeXAction" />
            </box>
          </box>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
