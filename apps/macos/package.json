{
  "name": "visualtex-macos",
  "private": true,
  "version": "1.2.6",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:desktop",
    "build:desktop": "tsc --noEmit && vite build",
    "prepare:ocr-offline": "python3 scripts/prepare_offline_ocr_runtime.py",
    "prepare:ocr-model-packs": "python3 scripts/prepare_offline_ocr_runtime.py --with-optional-model-packs",
    "build:all": "npm run build:desktop",
    "build:bundle": "node scripts/build_platform_bundle.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri_dev.mjs",
    "register:macos-dev-url": "node scripts/register_macos_dev_url_handler.mjs",
    "tauri:build": "node scripts/tauri_build.mjs",
    "test:input-behavior": "npm run build:desktop && node scripts/input_behavior_regression.mjs",
    "test:radical-render": "npm run build:desktop && node scripts/radical_render_regression.mjs",
    "test:formula-hotkeys": "npm run build:desktop && node scripts/formula_hotkey_regression.mjs",
    "test:custom-symbols": "npm run build:desktop && tsx scripts/custom_symbol_registry_regression.mts && node scripts/custom_symbol_noninterference_regression.mjs && node scripts/custom_symbol_glyph_compiler_regression.mjs && node scripts/custom_symbol_designer_ui_regression.mjs && node scripts/custom_symbol_runtime_sync_regression.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib system_math_glyphs",
    "test:align-cases": "npm run build:desktop && node scripts/align_cases_regression.mjs",
    "test:ocr-multiline": "tsx scripts/ocr_multiline_formula_rows_regression.ts && tsx scripts/ocr_align_copy_acceptance.mts",
    "test:ocr-provider": "tsx scripts/ocr_provider_transport_regression.mts && cargo test --manifest-path src-tauri/Cargo.toml --lib ocr_provider -- --nocapture",
    "test:ocr-editor": "npm run build:desktop && tsx scripts/ocr_multiline_editor_browser_regression.mts",
    "test:ocr-parity": "npm run test:ocr-multiline && npm run test:ocr-provider && npm run test:ocr-editor && npm run test:ocr-payload-safety && npm run test:quick-ocr-hud-safety",
    "test:keypad-mode": "npm run build:desktop && node scripts/keypad_mode_regression.mjs",
    "test:history": "node scripts/history_manager_smoke.mjs",
    "test:toolbar-completion": "npm run build:desktop && tsx scripts/toolbar_template_completion_regression.mts && node scripts/targeted_editor_regression.mjs toolbar-template-completion",
    "test:latex-format": "node --experimental-strip-types scripts/latex_format_smoke.mjs",
    "test:source-structural": "npm run build:desktop && tsx scripts/source_structural_draft_regression.mts && node scripts/targeted_editor_regression.mjs source-auto-close-completion && node scripts/targeted_editor_regression.mjs source-preview-only",
    "test:source-editor-ux": "npm run build:desktop && tsx scripts/source_editor_ux_regression.mts && node scripts/targeted_editor_regression.mjs source-editor-ux",
    "test:inline-text-latex-format": "tsx scripts/inline_text_latex_format_regression.mts",
    "test:markdown-export": "node --experimental-strip-types scripts/markdown_export_smoke.mjs",
    "test:document-import": "npm run build:desktop && npm run test:document-import:parser && node scripts/document_import_word_layout_smoke.mjs && npm run test:document-import:browser",
    "test:document-import:parser": "tsx scripts/document_import_parser_smoke.mjs && tsx scripts/document_import_parser_corpus.mjs",
    "test:document-import:browser": "node scripts/run_document_import_browser_suite.mjs",
    "test:document-import:word": "node scripts/run_document_import_word_suite.mjs",
    "test:word-latex-redraw": "tsx scripts/word_latex_redraw_parser_regression.mts",
    "test:update-notes": "node --experimental-strip-types scripts/update_notes_smoke.mjs",
    "test:update-safety": "tsx scripts/update_service_safety_regression.mts",
    "test:svg-export": "tsx scripts/svg_export_smoke.mjs",
    "test:rare-integral-glyphs": "node --experimental-strip-types scripts/rare_integral_glyph_registry_regression.mjs",
    "test:mathlive-integrals": "npm run build:desktop && node scripts/mathlive_integral_regression.mjs",
    "test:mathlive-runtime-safety:run": "tsx scripts/mathlive_runtime_safety_patch_regression.mts && tsx scripts/mathlive_option_guard_regression.mts && node scripts/mathlive_runtime_safety_browser_regression.mjs",
    "test:mathlive-runtime-safety": "npm run build:desktop && npm run test:mathlive-runtime-safety:run",
    "test:native-suggestion-previews": "npm run build:desktop && node scripts/native_suggestion_preview_regression.mjs --audit",
    "test:word-omml": "node scripts/word_omml_regression.mjs",
    "test:word-image-fonts": "tsx scripts/word_image_font_regression.mjs",
    "verify:ocr-offline": "python3 scripts/verify_offline_ocr_bundle.py",
    "verify:ocr-offline:full": "python3 scripts/verify_offline_ocr_bundle.py --full",
    "verify:ocr-model-packs": "python3 scripts/verify_offline_ocr_bundle.py --model-packs dist-ocr/model-packs/macos-arm64",
    "test:ime-enter": "tsx scripts/ime_enter_regression.mjs",
    "test:office-formula-editor": "tsx scripts/office_formula_editor_regression.mjs",
    "test:office-session-safety": "tsx scripts/office_session_payload_safety_regression.mts",
    "test:quick-ocr-hud-safety": "tsx scripts/quick_ocr_hud_payload_safety_regression.mts",
    "test:macos-office-status-safety": "tsx scripts/macos_office_status_payload_safety_regression.mts",
    "test:ocr-payload-safety": "tsx scripts/ocr_payload_safety_regression.mts",
    "test:document-import-payload-safety": "tsx scripts/document_import_payload_safety_regression.mts",
    "test:native-ui-payload-safety": "tsx scripts/native_ui_payload_safety_regression.mts",
    "test:office-silent-conversion": "npm run build:desktop && node scripts/office_silent_conversion_regression.mjs",
    "test:macos-offline-office": "npm run test:ime-enter && npm run test:office-formula-editor && npm run test:word-image-fonts && npm run test:word-latex-redraw && node scripts/macos_offline_office_smoke.mjs",
    "test:macos-offline-office:full": "node scripts/run_macos_offline_acceptance.mjs",
    "verify:office-performance-budget": "node scripts/verify_office_performance_budget.mjs",
    "package:macos-offline-office": "node scripts/package_macos_offline_addins.mjs",
    "test:platform-onboarding": "tsx scripts/platform_onboarding_smoke.mjs",
    "test:startup-compatibility": "tsx scripts/startup_compatibility_smoke.mjs",
    "test:startup-browser": "node scripts/startup_browser_regression.mjs",
    "verify:mac-dmg": "bash scripts/verify_macos_dmg.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@lezer/highlight": "^1.2.3",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "mathjax-full": "^3.2.2",
    "mathlive": "^0.109.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
