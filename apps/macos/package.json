{
  "name": "visualtex-macos",
  "private": true,
  "version": "1.3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:desktop",
    "build:desktop": "tsc --noEmit && vite build",
    "build:all": "npm run build:desktop",
    "build:bundle": "node scripts/build_platform_bundle.mjs",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri_dev.mjs",
    "tauri:build": "node scripts/tauri_build.mjs",
    "tauri:build:no-ocr": "node scripts/build_macos_api_only.mjs",
    "prepare:ocr-offline": "python3 scripts/prepare_offline_ocr_runtime.py",
    "prepare:ocr-model-packs": "python3 scripts/prepare_offline_ocr_runtime.py --with-optional-model-packs",
    "register:macos-dev-url": "node scripts/register_macos_dev_url_handler.mjs",
    "test:align-cases": "npm run build:desktop && node scripts/align_cases_regression.mjs",
    "test:accent-reopen": "npm run build:desktop && node ../shared/visualtex-app/tests/accent_reopen_regression.mjs",
    "test:anywhere-unicode": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/anywhere_unicode_regression.mts",
    "test:candidate-panel": "npm run build:desktop && node ../shared/visualtex-app/tests/candidate_panel_audit.mjs --digits",
    "test:candidate-theme-colors": "npm run build:desktop && node ../shared/visualtex-app/tests/candidate_theme_colors_regression.mjs",
    "test:core-latex-compatibility": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/core_latex_command_compatibility_regression.mts",
    "test:custom-symbols": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/custom_symbol_registry_regression.mts && node scripts/custom_symbol_noninterference_regression.mjs && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/custom-symbol-designer/tests/tex_export.test.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/custom-symbol-designer/tests/tex_native_compare.test.mts && node ../shared/visualtex-app/tests/custom_symbol_designer_regression.mjs && node scripts/custom_symbol_runtime_sync_regression.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib system_math_glyphs",
    "test:caret-underline": "npm run build:desktop && node ../shared/visualtex-app/tests/caret_underline_regression.mjs",
    "test:caret-operand": "npm run build:desktop && node ../shared/visualtex-app/tests/caret_operand_regression.mjs",
    "test:operand-mathml": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/operand_mathml_regression.mts",
    "test:anywhere-candidates": "npm run build:desktop && node ../shared/visualtex-app/tests/anywhere_candidates_regression.mjs",
    "test:document-display-formula-insert": "npm run build:desktop && node ../shared/visualtex-app/tests/document_display_formula_insert_regression.mjs",
    "test:document-formula-residency": "npm run build:desktop && node ../shared/visualtex-app/tests/document_formula_residency_regression.mjs",
    "test:document-import": "npm run build:desktop && npm run test:document-import:parser && node scripts/document_import_word_layout_smoke.mjs && npm run test:document-import:browser",
    "test:document-import-payload-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_payload_safety_regression.mts",
    "test:document-import:browser": "node scripts/run_document_import_browser_suite.mjs",
    "test:document-import:parser": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_parser_smoke.mjs && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/document_import_parser_corpus.mjs",
    "test:document-import:word": "node scripts/run_document_import_word_suite.mjs",
    "test:document-scrollbar-style": "npm run build:desktop && node ../shared/visualtex-app/tests/document_scrollbar_style_regression.mjs",
    "test:editor-cleanup": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/command_registry_contract_regression.mts && node scripts/editor_cleanup_regression.mjs",
    "test:editor-lifecycle": "node scripts/editor_lifecycle_regression.mjs",
    "test:editor-refactor": "node --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/history_manager_smoke.mjs && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/editor_persistence_isolation_regression.mjs && node scripts/editor_session_regression.mjs && node scripts/editor_lifecycle_regression.mjs && node scripts/editor_cleanup_regression.mjs",
    "test:editor-scenarios": "npm run build:desktop && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs --all",
    "test:formula-slot-reachability": "npm run build:desktop && node ../shared/visualtex-app/tests/formula_slot_reachability_regression.mjs",
    "test:formula-hotkeys": "npm run build:desktop && node scripts/formula_hotkey_regression.mjs",
    "test:formula-lines": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/formula_lines_regression.mts",
    "test:history": "node --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/history_manager_smoke.mjs",
    "test:inline-text-latex-format": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/inline_text_latex_format_regression.mts",
    "test:input-behavior": "npm run build:desktop && node scripts/input_behavior_regression.mjs",
    "test:input-judgment": "npm run build:desktop && node ../shared/visualtex-app/tests/input_judgment_regression.mjs",
    "test:keypad-mode": "npm run build:desktop && node scripts/keypad_mode_regression.mjs",
    "test:latex-format": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/latex_format_smoke.mjs",
    "test:macos-office-status-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/macos_office_status_payload_safety_regression.mts",
    "test:macos-offline-office": "npm run test:office-formula-editor && npm run test:word-image-fonts && npm run test:word-latex-redraw && npm run test:office-session-safety && npm run test:macos-office-status-safety && python3 scripts/macos_offline_office_smoke.py",
    "test:macos-offline-office:full": "node scripts/run_macos_offline_acceptance.mjs",
    "test:markdown-export": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/markdown_export_smoke.mjs",
    "test:math-variant-compatibility": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/math_variant_compatibility_regression.mts",
    "test:mathlive-integrals": "npm run build:desktop && node scripts/mathlive_integral_regression.mjs",
    "test:mathlive-runtime-safety": "npm run build:desktop && npm run test:mathlive-runtime-safety:run",
    "test:mathlive-runtime-safety:run": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/mathlive_source_safety_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/editor_crash_recovery_regression.mts && node ../shared/visualtex-app/tests/mathlive_runtime_safety_browser_regression.mjs",
    "test:native-suggestion-previews": "npm run build:desktop && node scripts/native_suggestion_preview_regression.mjs --audit",
    "test:native-ui-payload-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/native_ui_payload_safety_regression.mts",
    "test:ocr-editor": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_multiline_editor_browser_regression.mts",
    "test:ocr-multiline": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/ocr_multiline_formula_rows_regression.ts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/ocr_align_copy_acceptance.mts",
    "test:ocr-parity": "npm run test:ocr-multiline && npm run test:ocr-provider && npm run test:ocr-editor && npm run test:ocr-payload-safety && npm run test:quick-ocr-hud-safety",
    "test:ocr-payload-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_payload_safety_regression.mts",
    "test:ocr-provider": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_provider_transport_regression.mts && cargo test --manifest-path src-tauri/Cargo.toml --lib ocr_provider -- --nocapture",
    "test:office-formula-editor": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/office_formula_editor_regression.mjs",
    "test:office-numbering-edit": "npm run build:desktop && node scripts/office_numbering_edit_regression.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib word_numbering_only_fast_path",
    "test:office-session-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/office_session_payload_safety_regression.mts",
    "test:office-silent-conversion": "npm run build:desktop && node scripts/office_silent_conversion_regression.mjs",
    "test:physics-kernel": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/physics_kernel_compatibility_regression.mts && node ../shared/visualtex-app/tests/physics_kernel_browser_regression.mjs",
    "test:platform-onboarding": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/platform_onboarding_smoke.mjs",
    "test:ported-editor": "node scripts/ported_editor_regression.mjs",
    "test:quick-ocr-hud-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/quick_ocr_hud_payload_safety_regression.mts",
    "test:radical-render": "npm run build:desktop && node ../shared/visualtex-app/tests/radical_render_regression.mjs",
    "test:rare-integral-glyphs": "node --experimental-strip-types --import ../shared/visualtex-app/testing/node-loader.mjs scripts/rare_integral_glyph_registry_regression.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib --no-fail-fast",
    "test:selection": "node scripts/selection_regression.mjs",
    "test:source-editor-ux": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/source_editor_ux_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-editor-ux",
    "test:source-structural": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/source_structural_draft_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-auto-close-completion && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-preview-only",
    "test:startup-browser": "node scripts/startup_browser_regression.mjs",
    "test:startup-compatibility": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/startup_compatibility_smoke.mjs",
    "test:svg-export": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/svg_export_smoke.mjs",
    "test:toolbar-completion": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/toolbar_template_completion_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs toolbar-template-completion",
    "test:universal-source-display-style": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/universal_source_display_style_regression.mts",
    "test:update-notes": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/update_notes_smoke.mjs",
    "test:update-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/update_service_safety_regression.mts",
    "test:word-idle": "node scripts/word_idle_noninterference_regression.mjs",
    "test:word-image-fonts": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/word_image_font_regression.mjs",
    "test:word-latex-redraw": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/word_latex_redraw_parser_regression.mts",
    "test:word-numbering-edit": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/word_numbering_edit_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/word_numbering_edit_regression.mts --run",
    "test:word-omml": "node scripts/word_omml_regression.mjs",
    "verify:mac-dmg": "bash scripts/verify_macos_dmg.sh",
    "verify:mac-dmg:no-ocr": "bash scripts/verify_macos_api_only_dmg.sh",
    "verify:mac-clean-install": "bash scripts/macos_clean_install_acceptance.sh",
    "verify:ocr-model-packs": "python3 scripts/verify_offline_ocr_bundle.py --model-packs dist-ocr/model-packs/macos-arm64",
    "verify:ocr-offline": "python3 scripts/verify_offline_ocr_bundle.py",
    "verify:ocr-offline:full": "python3 scripts/verify_offline_ocr_bundle.py --full",
    "verify:office-performance-budget": "node scripts/verify_office_performance_budget.mjs",
    "compile:powerpoint-addin": "node scripts/compile_powerpoint_native_math.mjs --project NativeOmmlRelease",
    "package:macos-offline-office": "node scripts/package_macos_offline_addins.mjs"
  },
  "checks": {
    "build": [
      "build:desktop"
    ],
    "timeouts": {
      "test:rust": 5400,
      "test:editor-scenarios": 3600
    },
    "skip": {
      "test:word-idle": "drives Microsoft Word",
      "test:word-numbering-edit": "drives Microsoft Word",
      "test:document-import:word": "drives Microsoft Word",
      "test:macos-offline-office": "checks the packaged Office add-ins (npm run package:macos-offline-office); its other parts run on their own",
      "test:macos-offline-office:full": "drives the installed Office apps",
      "verify:ocr-offline": "checks a built offline OCR bundle",
      "verify:ocr-offline:full": "checks a built offline OCR bundle",
      "verify:ocr-model-packs": "checks the built OCR model packs",
      "verify:mac-dmg": "checks a built DMG",
      "verify:mac-dmg:no-ocr": "checks a built DMG",
      "verify:mac-clean-install": "installs a built DMG into /Applications and checks the installed app",
      "verify:office-performance-budget": "checks a performance record taken in the installed Office apps"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.3.3",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
