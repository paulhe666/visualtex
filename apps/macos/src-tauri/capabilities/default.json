{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for VisualTeX",
  "windows": ["main", "office-native-*", "quick-ocr-hud"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/paulhe666/visualtex/releases" },
        { "url": "https://github.com/paulhe666/visualtex/releases/*" }
      ]
    }
  ]
}
