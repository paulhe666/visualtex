          nextState: "2"
        },
        d: {
          action_: ["output", { type_: "insert", option: "hyphen" }],
          nextState: "2"
        }
      },
      "-": {
        "0|1|2": {
          action_: [
            { type_: "output", option: 1 },
            "beginsWithBond=true",
            { type_: "bond", option: "-" }
          ],
          nextState: "3"
        },
        "3": { action_: { type_: "bond", option: "-" } },
        "a": {
          action_: ["output", { type_: "insert", option: "hyphen" }],
          nextState: "2"
        },
        "as": {
          action_: [
            { type_: "output", option: 2 },
            { type_: "bond", option: "-" }
          ],
          nextState: "3"
