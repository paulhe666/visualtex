{
  "name": "visualtex-windows",
  "private": true,
  "version": "1.3.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:desktop",
    "build:desktop": "tsc --noEmit && vite build",
    "build:office:windows-native": "tsc -p tsconfig.office.json --noEmit && vite build -c vite.office.windows-native.config.ts && node scripts/finalize_office_platform_build.mjs windows-native",
    "build:office": "npm run build:office:windows-native",
    "build:all": "npm run build:desktop && npm run build:office:windows-native",
    "build:bundle": "node scripts/build_platform_bundle.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/tauri_build.mjs",
    "tauri:build:no-ocr": "node scripts/tauri_build.mjs --no-ocr-bundle",
    "clean:windows-release": "node scripts/clean_windows_release_outputs.mjs",
    "clean:windows-local:dry-run": "node scripts/clean_windows_release_outputs.mjs --acceptance --dry-run",
    "clean:windows-local": "node scripts/clean_windows_release_outputs.mjs --acceptance",
    "test:accent-reopen": "npm run build:desktop && node ../shared/visualtex-app/tests/accent_reopen_regression.mjs",
    "test:anywhere-unicode": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/anywhere_unicode_regression.mts",
    "test:application-configuration": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/application_configuration_regression.mts",
    "test:application-data": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/application_data_regression.mts",
    "test:candidate-panel": "npm run build:desktop && node ../shared/visualtex-app/tests/candidate_panel_audit.mjs --digits",
    "test:candidate-theme-colors": "npm run build:desktop && node ../shared/visualtex-app/tests/candidate_theme_colors_regression.mjs",
    "test:custom-symbol-designer": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/custom-symbol-designer/tests/tex_export.test.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/custom-symbol-designer/tests/tex_native_compare.test.mts && node ../shared/visualtex-app/tests/custom_symbol_designer_regression.mjs",
    "test:caret-underline": "npm run build:desktop && node ../shared/visualtex-app/tests/caret_underline_regression.mjs",
    "test:caret-operand": "npm run build:desktop && node ../shared/visualtex-app/tests/caret_operand_regression.mjs",
    "test:exam-zh-signs": "npm run build:desktop && node ../shared/visualtex-app/tests/exam_zh_signs_regression.mjs",
    "test:toolbar-picker": "npm run build:desktop && node ../shared/visualtex-app/tests/toolbar_picker_regression.mjs",
    "test:operand-mathml": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/operand_mathml_regression.mts",
    "test:anywhere-candidates": "npm run build:desktop && node ../shared/visualtex-app/tests/anywhere_candidates_regression.mjs",
    "test:command-permissions": "node scripts/command_permissions_smoke.mjs",
    "test:document-display-formula-insert": "npm run build:desktop && node ../shared/visualtex-app/tests/document_display_formula_insert_regression.mjs",
    "test:document-formula-residency": "npm run build:desktop && node ../shared/visualtex-app/tests/document_formula_residency_regression.mjs",
    "test:document-import-compiled-latex": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_compiled_latex_acceptance.mts",
    "test:document-import-compiled-markdown": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_compiled_markdown_acceptance.mts",
    "test:document-import-file": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_file_regression.mts",
    "test:document-import-parser": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/document_import_parser_coverage.mts",
    "test:document-file-library": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/document_file_library_regression.mts",
    "test:document-file-workspace": "npm run build:desktop && node ../shared/visualtex-app/tests/document_file_workspace_regression.mjs",
    "test:document-markdown-file": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/document_markdown_file_regression.mts",
    "test:document-scrollbar-style": "npm run build:desktop && node ../shared/visualtex-app/tests/document_scrollbar_style_regression.mjs",
    "test:document-tutorial-cards": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/document_tutorial_cards_regression.mts",
    "test:document-tutorial-fit": "npm run build:desktop && node ../shared/visualtex-app/tests/document_tutorial_fit_regression.mjs",
    "test:dotnet": "dotnet test src-windows/VisualTeX.WindowsOffice.Tests/VisualTeX.WindowsOffice.Tests.csproj --configuration Release && dotnet test src-windows/VisualTeX.NativeRender.Tests/VisualTeX.NativeRender.Tests.csproj --configuration Release",
    "test:editor": "npm run build && npm run test:editor:run",
    "test:editor-history": "npm run build && npm run test:editor-history:run",
    "test:editor-history:run": "node scripts/editor_history_regression.mjs",
    "test:editor-scenarios": "npm run build:desktop && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs --all",
    "test:editor:run": "node scripts/editor_regression_smoke.mjs",
    "test:formula-slot-reachability": "npm run build:desktop && node ../shared/visualtex-app/tests/formula_slot_reachability_regression.mjs",
    "test:formula-hotkeys": "npm run build:desktop && node scripts/formula_hotkey_regression.mjs",
    "test:formula-lines": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/formula_lines_regression.mts",
    "test:history": "node --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/history_manager_smoke.mjs",
    "test:inline-text-latex-format": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/inline_text_latex_format_regression.mts",
    "test:input-behavior": "npm run build:desktop && node scripts/input_behavior_regression.mjs",
    "test:office-candidates": "npm run build:office:windows-native && node scripts/office_candidate_sync_regression.mjs",
    "test:office-formula-faces": "npm run build:office:windows-native && node scripts/office_formula_faces_regression.mjs",
    "test:input-judgment": "npm run build:desktop && node ../shared/visualtex-app/tests/input_judgment_regression.mjs",
    "test:latest-macos-editor": "npm run build:desktop && node scripts/run_latest_macos_editor_regressions.mjs",
    "test:latex-format": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/latex_format_smoke.mjs",
    "test:macos-feature-parity": "npm run test:mixed-latex-format && npm run test:math-variant-compatibility && npm run test:svg-system-font-transform && npm run test:latex-format",
    "test:markdown-export": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/markdown_export_smoke.mjs",
    "test:math-variant-compatibility": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/math_variant_compatibility_regression.mts",
    "test:mathjax-kernel-parity": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/generate_mathjax_kernel_parity.mts --check",
    "test:mathlive-contour-bm": "npm run build:desktop && node scripts/mathlive_contour_bm_regression.mjs",
    "test:mathlive-runtime-safety": "npm run build:desktop && npm run test:mathlive-runtime-safety:run",
    "test:mathlive-runtime-safety:run": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/mathlive_runtime_safety_patch_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/mathlive_option_guard_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/mathlive_source_safety_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/editor_crash_recovery_regression.mts && node ../shared/visualtex-app/tests/mathlive_runtime_safety_browser_regression.mjs",
    "test:mathtype-align-geometry": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/math_type_alignment_geometry_acceptance.mts",
    "test:mixed-latex-format": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/mixed_latex_format_regression.mts",
    "test:native-ui-payload-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/native_ui_payload_safety_regression.mts",
    "test:ocr-align-editor": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/ocr_align_editor_geometry_acceptance.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/ocr_align_copy_acceptance.mts",
    "test:ocr-install": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_install_regression.ts && python scripts/ocr_warmup_regression.py && cargo test --manifest-path src-tauri/Cargo.toml --lib --no-run && cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-install-acceptance --bin ocr_install_acceptance && cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-python-bundle-acceptance --bin ocr_python_bundle_acceptance && cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-storage-acceptance --bin ocr_storage_acceptance && npm run test:ocr-models",
    "test:ocr-models": "cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-model-acceptance --bin ocr_model_acceptance -- range && cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-model-acceptance --bin ocr_model_acceptance -- import-l && cargo run --quiet --manifest-path src-tauri/Cargo.toml --features ocr-model-acceptance --bin ocr_model_acceptance -- switch-upgrade",
    "test:ocr-payload-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_payload_safety_regression.mts",
    "test:ocr-provider-transport": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/ocr_provider_transport_regression.mts",
    "test:office-apply-shortcut": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/office_apply_shortcut_regression.mts",
    "test:office-font-size": "npm run build:office:windows-native && node scripts/office_font_size_regression.mjs",
    "test:office-formula-document": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/office_formula_document_regression.mts",
    "test:office-formula-shortcuts": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/office_formula_shortcut_regression.mts",
    "test:office-metadata": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/office_metadata_smoke.mjs",
    "test:office-ocr": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/office_ocr_transport_smoke.mjs && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/ocr_multiline_formula_rows_regression.ts",
    "test:office-session-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/office_session_payload_safety_regression.mts",
    "test:physics-kernel": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/physics_kernel_compatibility_regression.mts && node ../shared/visualtex-app/tests/physics_kernel_browser_regression.mjs",
    "test:platform-onboarding": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/platform_onboarding_smoke.mjs",
    "test:powerpoint-double-click-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/powerpoint_double_click_hook_safety_regression.mts",
    "test:radical-render": "npm run build:desktop && node ../shared/visualtex-app/tests/radical_render_regression.mjs",
    "test:responsive-layout": "npm run build:all && npm run test:responsive-layout:run",
    "test:responsive-layout:run": "node scripts/windows_responsive_layout_regression.mjs",
    "test:runtime-ownership": "node scripts/office_session_ownership_regression.cjs && tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/storage_contract_regression.mts && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/editor_crash_recovery_regression.mts",
    "test:rust:windows": "node scripts/run_windows_rust_tests.mjs",
    "test:silent-ocr-hud-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/silent_ocr_hud_payload_safety_regression.mts",
    "test:source-editor-ux": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/source_editor_ux_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-editor-ux",
    "test:source-structural": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/source_structural_draft_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-auto-close-completion && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs source-preview-only",
    "test:source-wrappers": "npm run build:desktop && node --import tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/source_wrapper_registry_regression.mts && node --import tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/source_wrapper_browser_regression.mts",
    "test:svg-export": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/svg_export_smoke.mjs",
    "test:svg-system-font-transform": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/svg_system_font_transform_regression.mts",
    "test:toolbar-completion": "npm run build:desktop && tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts scripts/toolbar_template_completion_regression.mts && node ../shared/visualtex-app/tests/editor-scenarios/runner.mjs toolbar-template-completion",
    "test:universal-source-display-style": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs --import ../shared/visualtex-app/testing/kernel-node.mts ../shared/visualtex-app/tests/universal_source_display_style_regression.mts",
    "test:update-notes": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/update_notes_smoke.mjs",
    "test:update-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs ../shared/visualtex-app/tests/update_service_safety_regression.mts",
    "test:windows-app-lifecycle": "node scripts/windows_app_lifecycle_smoke.mjs",
    "test:windows-cases": "npm run build:desktop && node scripts/windows_cases_regression.mjs",
    "test:windows-ocr-editor-parity": "node scripts/windows_ocr_editor_parity_regression.mjs",
    "test:windows-office-architecture": "node scripts/windows_office_architecture_smoke.mjs",
    "test:windows-office-diagnostics": "node scripts/windows_office_diagnostics_smoke.mjs",
    "test:windows-office-paths": "node scripts/run_windows_powershell.mjs scripts/test_windows_office_path_resolution.ps1",
    "test:windows-office-status-safety": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/windows_office_status_payload_safety_regression.mts",
    "test:wps-diagnosis-report": "tsx --import ../shared/visualtex-app/testing/node-loader.mjs scripts/wps_diagnosis_report_regression.mts",
    "test:windows-resource-ownership": "powershell.exe -NoProfile -File scripts/test_clipboard_ownership.ps1",
    "verify:embedded-frontend": "node scripts/verify_embedded_frontend_assets.mjs",
    "verify:frontend-dist": "node scripts/verify_frontend_dist.mjs",
    "verify:office-native": "npm run build:office:windows-native && node scripts/windows_office_architecture_smoke.mjs",
    "release:install-silently": "node scripts/run_windows_powershell.mjs scripts/install_current_windows_release_silently.ps1",
    "verify:installed-release": "node scripts/run_windows_powershell.mjs scripts/verify_installed_windows_release.ps1",
    "verify:windows-release": "node scripts/run_windows_powershell.mjs scripts/verify_windows_release_artifacts.ps1"
  },
  "checks": {
    "build": [
      "build:desktop",
      "build:office:windows-native"
    ],
    "timeouts": {
      "test:rust:windows": 5400,
      "test:dotnet": 3600,
      "test:editor-scenarios": 3600
    },
    "skip": {
      "test:ocr-install": "installs and warms up the OCR runtime",
      "test:ocr-models": "needs the OCR model packs",
      "verify:windows-release": "checks the artifacts of a release build (npm run tauri:build)",
      "verify:installed-release": "checks the installed release (npm run release:install-silently)",
      "verify:embedded-frontend": "checks the frontend inside a release executable (npm run tauri:build)",
      "verify:office-native": "the same check as test:windows-office-architecture"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "codemirror-lang-latex": "^0.4.1",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.3.3",
    "mathjax-full": "^3.2.2",
    "mermaid": "^11.17.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shiki": "^4.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "tsx": "^4.20.6",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
