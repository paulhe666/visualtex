import assert from 'node:assert/strict';import{latexToMathMl}from'../src/export/runtime.ts';import{DOMParser}from'@xmldom/xmldom';import{writeFileSync}from'node:fs';
const pairs=[[String.raw`\aleph \wp \Re \Im \ell`,String.raw`\aleph \mathrm{\wp}\Re \Im \ell`],[String.raw`\limsup_{n\to \infty}`,String.raw`\limsup_{n\to \mathrm{\infty}}`],[String.raw`\liminf_{n\to \infty}`,String.raw`\liminf_{n\to \mathrm{\infty}}`]];
function leaves(xml:string){return Array.from(new DOMParser().parseFromString(xml,'application/xml').getElementsByTagName('*')).filter((x:any)=>['mi','mo','mn','mtext'].includes(x.tagName)).map((x:any)=>({role:x.tagName,text:x.textContent,variant:x.getAttribute('mathvariant')||(x.tagName==='mi'&&Array.from(x.textContent).length===1?'italic':'normal'),alternate:x.getAttribute('data-mjx-alternate')||''}));}
const rows=[];for(const[p,q]of pairs){const a=await latexToMathMl(p,false),b=await latexToMathMl(q,false);assert.deepEqual(leaves(a),leaves(b));rows.push({oldSource:p,newSource:q,oldMathMl:a,newMathMl:b,passed:true});}writeFileSync('../../artifacts/conversion-symbol-audit-20261002/cp239-upright-spelling-equivalence.json',JSON.stringify({passed:3,rows},null,2));console.log('3/3 explicit-normal source spelling comparisons preserve exact token role, scalar, effective style and alternate');
