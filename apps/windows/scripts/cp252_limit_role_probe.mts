import {latexToMathMl} from '../src/export/runtime.ts';import {writeFileSync,existsSync} from 'node:fs';import {DOMParser} from '@xmldom/xmldom';
const rows=[];for(const name of ['lim','max','min','sup','inf','limsup','liminf']){const under=name==='lim'?String.raw`x\to0`:name.startsWith('lim')?String.raw`n\to\mathrm{\infty}`:String.raw`x\in A`;const legacy='\\'+name+'_{'+under+'}';const candidate='\\underset{'+under+'}{\\operatorname{'+name+'}}';const before=await latexToMathMl(legacy,false),after=await latexToMathMl(candidate,false);function inspect(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');const nodes=Array.from(d.getElementsByTagName('*'));return{underCount:nodes.filter(n=>n.localName==='munder').length,base:nodes.find(n=>n.textContent===name&&['mi','mo'].includes(n.localName!))?.localName,markerCount:nodes.filter(n=>n.localName==='mo'&&n.textContent==='⁡').length};}rows.push({name,legacy,candidate,before,after,legacyContract:inspect(before),candidateContract:inspect(after),expectedBase:'mi',expectedUnderCount:1,expectedApplicationMarkers:0});}
const p='../../artifacts/conversion-symbol-audit-20261002/cp252-function-recovery/limit-role-evidence.json';if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify(rows,null,2));console.log(JSON.stringify(rows.map(({before,after,...x})=>x)));
