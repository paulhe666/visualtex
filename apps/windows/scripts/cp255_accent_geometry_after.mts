import {latexToMathMl} from '../src/export/runtime.ts';import {readFileSync,writeFileSync,existsSync} from 'node:fs';import {DOMParser} from '@xmldom/xmldom';
const root='../../artifacts/conversion-symbol-audit-20261002/';const input=JSON.parse(readFileSync(root+'cp255-accent-source-after.json','utf8').replace(/^\uFEFF/,''));function facts(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');return Array.from(d.getElementsByTagName('*')).filter(e=>e.localName==='mover').map(e=>{const c=Array.from(e.childNodes).filter(n=>n.nodeType===1) as Element[];const mark=c[1];return {mark:mark.textContent,stretchy:mark.getAttribute('stretchy')||'dictionary-default',variant:mark.getAttribute('mathvariant')||'normal'};});}for(const r of input.rows){r.reparsed=await latexToMathMl(r.sourceRecovered,false);r.expectedAccent=facts(r.mathMl);r.actualAccent=facts(r.reparsed);r.passed=JSON.stringify(r.expectedAccent)===JSON.stringify(r.actualAccent);}const p=root+'cp255-accent-geometry-after.json';if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify(input,null,2));console.log(JSON.stringify(input.rows.map((r:any)=>({id:r.id,latex:r.latex,recovered:r.sourceRecovered,passed:r.passed,expected:r.expectedAccent,actual:r.actualAccent}))));
if(input.rows.some((r:any)=>!r.passed))process.exitCode=1;
