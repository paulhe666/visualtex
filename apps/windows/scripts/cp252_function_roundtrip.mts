import {readFileSync,writeFileSync,existsSync} from 'node:fs';
import {DOMParser} from '@xmldom/xmldom';
import {latexToMathMl} from '../src/export/runtime.ts';
import {convertLatexToMathMl} from 'mathlive';
const base='../../artifacts/conversion-symbol-audit-20261002/cp252-function-recovery/';
const sources=[String.raw`\sin x`,String.raw`\operatorname{sin}x`,String.raw`\mathit{\operatorname{sin}x}`,String.raw`\cos x`,String.raw`\operatorname{cos}x`,String.raw`\operatorname{foo}x`,String.raw`\mathrm{foo}x`,String.raw`\operatorname{foo}^{2}⁡x`,String.raw`\operatorname{sin}⁡+x`,String.raw`\operatorname{sin}⁡\,x`,String.raw`\operatorname{foo}\operatorname{bar}x`,String.raw`\lim_{x\to0}x`];
function save(name:string,value:unknown){const p=base+name;if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify(value,null,2));}
function tokens(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');return Array.from(d.getElementsByTagName('*')).filter(e=>['mi','mo','mn','mtext'].includes(e.localName!)).map(e=>({kind:e.localName,text:e.textContent,style:e.getAttribute('mathvariant')||((e.localName==='mi'&&e.textContent?.length===1)?'italic':'normal'),op:e.localName==='mi'?(e.getAttribute('data-mjx-texclass')||null):null}));}
if(process.argv[2]==='prepare'){const rows=[];for(let i=0;i<sources.length;i++)rows.push({id:'F'+(i+1),latex:sources[i],mathMl:await latexToMathMl(sources[i],false)});save('input.json',rows);console.log('Prepared12');}
else{const r=JSON.parse(readFileSync(base+'product.json','utf8').replace(/^\uFEFF/,''));for(const row of r.rows){row.sourceReparsed=await latexToMathMl(row.sourceRecovered,false);row.sourcePass=JSON.stringify(tokens(row.mathMl))===JSON.stringify(tokens(row.sourceReparsed));row.editorMathMl=convertLatexToMathMl(row.sourceRecovered);row.nativeReparsed=await latexToMathMl(row.nativeRecovered,false);row.nativePass=JSON.stringify(tokens(row.mathMl))===JSON.stringify(tokens(row.nativeReparsed));}save('roundtrip.json',r);console.log(JSON.stringify(r.rows.map((x:any)=>({id:x.id,sourcePass:x.sourcePass,nativePass:x.nativePass,sourceRecovered:x.sourceRecovered,editorMathMl:x.editorMathMl})),null,2));}
