import {latexToMathMl} from '../src/export/runtime.ts';import {readFileSync,writeFileSync,existsSync} from 'node:fs';import {DOMParser} from '@xmldom/xmldom';
const root='../../artifacts/conversion-symbol-audit-20261002/';const source=JSON.parse(readFileSync(root+'cp253-accent-word-corpus.json','utf8'));const saved=JSON.parse(readFileSync(root+'cp253-accent-reverse-source.json','utf8'));function tokens(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');return Array.from(d.getElementsByTagName('*')).filter(e=>['mi','mo','mn'].includes(e.localName!)).map(e=>({kind:e.localName,text:e.textContent,variant:e.getAttribute('mathvariant')||(e.localName==='mi'&&e.textContent?.length===1?'italic':'normal')}));}
if(source.formulas.length!==saved.formulas.length)throw new Error('Count mismatch');const rows=[];for(let i=0;i<source.formulas.length;i++){const latex=saved.formulas[i].latex;const actual=await latexToMathMl(latex,source.formulas[i].displayMode==='block');rows.push({id:source.formulas[i].id,latex,expected:source.formulas[i].mathMl,actual,passed:JSON.stringify(tokens(source.formulas[i].mathMl))===JSON.stringify(tokens(actual))});}const p=root+'cp253-accent-saved-reparse.json';if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify({scope:'Saved cached-source reparse auxiliary to independent Word native payload lifecycle; width/pixels separate',rows},null,2));console.log(JSON.stringify(rows.map(x=>({id:x.id,latex:x.latex,passed:x.passed}))));
