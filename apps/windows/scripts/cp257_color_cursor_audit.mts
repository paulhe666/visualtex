import {latexToMathMl} from '../src/export/runtime.ts';
import {readFileSync,writeFileSync,existsSync} from 'node:fs';import {DOMParser} from '@xmldom/xmldom';
const root='../../artifacts/conversion-symbol-audit-20261002/cp257-color/';
const input=JSON.parse(readFileSync(root+'editor-reopen.json','utf8'));
function tokens(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');return Array.from(d.getElementsByTagName('*')).filter(e=>['mi','mo','mn'].includes(e.localName!)).map(e=>{let p:any=e;let color=null;while(p?.getAttribute){if(p.getAttribute('mathcolor')){color=p.getAttribute('mathcolor').toUpperCase();break;}p=p.parentNode;}return {kind:e.localName,text:e.textContent,color};});}
for(const row of input.rows){row.original=tokens(await latexToMathMl(row.source,false));row.loaded=tokens(await latexToMathMl(row.initial,false));row.after=tokens(await latexToMathMl(row.edited,false));row.loadPreserved=JSON.stringify(row.original)===JSON.stringify(row.loaded);row.existingPreserved=JSON.stringify(row.original)===JSON.stringify(row.after.slice(0,row.original.length));row.newTextInheritsCaret=row.after.slice(row.original.length).every((t:any)=>t.color===row.original.at(-1)?.color);row.passed=row.loadPreserved&&row.existingPreserved&&row.newTextInheritsCaret;}
const p=root+'editor-cursor-audit.json';if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify(input,null,2));console.log(JSON.stringify({passed:input.rows.filter((r:any)=>r.passed).length,total:input.rows.length}));if(input.rows.some((r:any)=>!r.passed))process.exitCode=1;