import {latexToMathMl} from '../src/export/runtime.ts';import {readFileSync,writeFileSync,existsSync} from 'node:fs';import {DOMParser} from '@xmldom/xmldom';
const root='../../artifacts/conversion-symbol-audit-20261002/';const input=JSON.parse(readFileSync(root+'cp253-editor-daily20-r2.json','utf8'));
function tokens(xml:string){const d=new DOMParser().parseFromString(xml,'application/xml');return Array.from(d.getElementsByTagName('*')).filter(e=>['mi','mo','mn'].includes(e.localName!)).map(e=>({kind:e.localName,text:e.textContent,variant:e.getAttribute('mathvariant')||(e.localName==='mi'&&e.textContent?.length===1?'italic':'normal')}));}
for(const row of input.rows){row.expected=await latexToMathMl(row.source+'+z',false);row.actual=await latexToMathMl(row.edited,false);row.passed=JSON.stringify(tokens(row.expected))===JSON.stringify(tokens(row.actual));}
const p=root+'cp253-editor-daily20-r2-reparse.json';if(existsSync(p))throw new Error('Refusing overwrite');writeFileSync(p,JSON.stringify(input,null,2));console.log(JSON.stringify(input.rows.filter((r:any)=>!r.passed).map((r:any)=>({source:r.source,edited:r.edited,passed:r.passed,expected:tokens(r.expected),actual:tokens(r.actual)}))));
