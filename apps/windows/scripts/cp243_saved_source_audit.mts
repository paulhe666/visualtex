import {readFileSync,writeFileSync}from'node:fs';import{latexToMathMl}from'../src/export/runtime.ts';import{DOMParser}from'@xmldom/xmldom';import{MmlMi}from'mathjax-full/js/core/MmlTree/MmlNodes/mi.js';
const base='../../artifacts/conversion-symbol-audit-20261002/cp240-font-open/';const expected=JSON.parse(readFileSync(base+'style20.json','utf8')).formulas;const saved=JSON.parse(readFileSync(base+'MT-VT20-cached-source.json','utf8')).formulas;
function tokens(s:string){const doc=new DOMParser().parseFromString(s,'application/xml');return Array.from(doc.getElementsByTagName('*')).filter((e:any)=>['mi','mo','mn','mtext'].includes(e.localName)).map((e:any)=>{let variant='';for(let p=e;p&&p.nodeType===1;p=p.parentNode){if(p.hasAttribute('mathvariant')){variant=p.getAttribute('mathvariant');break;}}return{kind:e.localName,text:e.textContent,style:variant||(e.localName==='mi'&&MmlMi.singleCharacter.test(e.textContent)?'italic':'normal'),alternate:e.getAttribute('data-mjx-alternate')==='1'};});}
if(expected.length!==saved.length)throw Error('Source count mismatch');const rows=[];for(let i=0;i<expected.length;i++){const actualMathMl=await latexToMathMl(saved[i].latex,expected[i].displayMode==='block');const e=tokens(expected[i].mathMl),a=tokens(actualMathMl);rows.push({id:expected[i].id,expectedLatex:expected[i].latex,actualLatex:saved[i].latex,expected:e,actual:a,passed:JSON.stringify(e)===JSON.stringify(a),actualMathMl});}const r={scope:'Original source vs regenerated saved cached LaTeX; strict token role/scalar/effective-style/alternate, not pixels or a new native persistence check',passed:rows.filter(x=>x.passed).length,failed:rows.filter(x=>!x.passed).length,rows};writeFileSync(base+'MT-VT20-source-presentation.json',JSON.stringify(r,null,2));console.log(JSON.stringify({passed:r.passed,failed:r.failed,failedIds:rows.filter(x=>!x.passed).map(x=>x.id)}));
