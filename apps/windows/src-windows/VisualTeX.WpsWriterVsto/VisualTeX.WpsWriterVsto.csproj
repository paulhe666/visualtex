<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <Platforms>x86;x64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'x86'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'x86'">x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>VisualTeX.WpsWriterVsto</AssemblyName>
    <RootNamespace>VisualTeX.WpsWriterVsto</RootNamespace>
    <ComVisible>true</ComVisible>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.CSharp" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\VstoDependencyResolver.cs" Link="Shared\VstoDependencyResolver.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\OfficePluginLanguage.cs" Link="Shared\OfficePluginLanguage.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\OfficeErrorText.cs" Link="Shared\OfficeErrorText.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\RibbonIconData.cs" Link="Shared\RibbonIconData.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\RibbonIconProvider.cs" Link="Shared\RibbonIconProvider.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\RibbonVectorIconRenderer.cs" Link="Shared\RibbonVectorIconRenderer.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\MathMlToLatexConverter.cs" Link="Shared\MathMlToLatexConverter.cs" />
    <Compile Include="..\VisualTeX.WindowsOffice.VstoShared\FormulaXml.cs" Link="Shared\FormulaXml.cs" />
    <ProjectReference Include="..\VisualTeX.WindowsOffice.Contracts\VisualTeX.WindowsOffice.Contracts.csproj" />
    <!-- The Office PIAs come from NuGet and the two COM interface definitions
         live in OfficeInteropShims.cs, so no Office installation or registered
         type library is required to compile (including on CI agents). -->
    <PackageReference Include="Microsoft.Office.Interop.Word" Version="15.0.4797.1004" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\VisualTeX.WindowsOffice.VstoShared\MathTypeCore.projitems" />
</Project>
