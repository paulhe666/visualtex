{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisualTeX",
  "version": "1.2.6",
  "identifier": "com.visualtex.studio",
  "build": {
    "beforeDevCommand": "node scripts/build_office_for_platform.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/verify_frontend_dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "专业的 LaTeX 可视化公式编辑器",
    "longDescription": "使用可视化结构、智能命令候选、PaddleOCR 公式识别和实时源码共同编辑 LaTeX 数学公式。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "ocr/worker.py": "ocr/worker.py",
      "resources/ocr-python/windows-x64": "ocr-python/windows-x64",
      "resources/ocr-models/windows-x64": "ocr-models/windows-x64",
      "../src/math/STIXTwoMath-OFL-1.1.txt": "licenses/STIXTwoMath-OFL-1.1.txt"
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "template": "./target/nsis-template/visualtex-installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
