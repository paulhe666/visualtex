            { latex: "\\ldotp", aside: "low dot", class: "box" },
            { latex: "\\cdotp", aside: "center dot", class: "box" },
            { latex: "\\ldots", aside: "low ellipsis", class: "box" },
            { latex: "\\cdots", aside: "center ellipsis", class: "box" },
